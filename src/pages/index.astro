---
/**
 * Home — bold industrial editorial.
 * Reference language: Edison Motors / KAL Containers / luoitheptop —
 * full-bleed hero, numbered sections, oversized stats, strong rules, real imagery.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import LeadForm from '@/components/LeadForm.astro';
import ProductCard from '@/components/ProductCard.astro';
import FaqList from '@/components/FaqList.astro';
import { PRODUCT_CATEGORIES, SITE, CONTACT, TRUST_STATS } from '@/config/site';
import { seoFor } from '@/lib/content';

const products = await getCollection('products');
const path = '/';
const seo = seoFor(path);

const CATALOG_PDF =
  'https://sunshine-lotionpump.com/wp-content/uploads/sites/2/2026/07/Sunshine-Catalog.pdf';
const HERO_POSTER =
  'https://img.supcous.com/2026/04/21dec35f4422a9b46ecd7d43d392cb38.webp';

const families = PRODUCT_CATEGORIES.map((family) => {
  const inFamily = products.filter((p) => p.data.categories.includes(family.slug));
  return { ...family, count: inFamily.length, image: inFamily[0]?.data.image || '' };
}).filter((f) => f.count > 0);

const why = [
  {
    num: '01',
    title: 'Manufacturing excellence',
    body: 'Our 7,000 m² cosmetic pump facility runs 20 assembly machines and 2 automated assembly lines — factory-direct quality at wholesale prices.',
    points: ['50M+ spray pumps produced annually', 'Perfect safety record with full quality tracking'],
  },
  {
    num: '02',
    title: 'Precision standards',
    body: 'ISO 9001:2015 certified manufacturer. An in-house testing lab ensures every pump meets international standards for the US, EU and global markets.',
    points: ['±0.1 mm dimensional accuracy', 'Triple quality inspection before shipment'],
  },
  {
    num: '03',
    title: 'Fast, reliable delivery',
    body: 'Direct manufacturer with in-house mould making. No intermediaries — your order goes straight to our factory floor.',
    points: ['15–20 days standard, 12-day rush', '99.8% on-time delivery rate'],
  },
];

const stats = [
  { value: '7,000', unit: 'm²', label: 'Factory floor' },
  { value: '50M+', unit: '', label: 'Units per year' },
  { value: '10', unit: '', label: 'Injection machines' },
  { value: '4', unit: '', label: 'Assembly lines' },
];

const certifications = [
  'https://sunshine-lotionpump.com/wp-content/uploads/sites/2/2026/07/SGS1.png',
  'https://sunshine-lotionpump.com/wp-content/uploads/sites/2/2026/07/SGS2.png',
  'https://sunshine-lotionpump.com/wp-content/uploads/sites/2/2026/07/SGS3.png',
  'https://sunshine-lotionpump.com/wp-content/uploads/sites/2/2026/07/ISO-9001-Quality-Certifications.jpg',
];

const faqs = [
  {
    q: 'Who are we?',
    a: 'We are based in Cixi, Ningbo, Zhejiang, China, operating since 2018. We sell to the domestic market (50%), the Middle East (15%), North America (5%), South America (5%), Southeast Asia (5%), Oceania (5%), Eastern Asia (5%), Northern Europe (5%) and South Asia (5%).',
  },
  {
    q: 'How can we guarantee quality?',
    a: 'Always a pre-production sample before mass production; always a final inspection before shipment.',
  },
  {
    q: 'What can you buy from us?',
    a: 'Lotion pumps, trigger sprayers, mist sprayers, cream pumps and caps.',
  },
  {
    q: 'Why should you buy from us and not from other suppliers?',
    a: 'Competitive price, good quality and a reliable delivery time.',
  },
  {
    q: 'What services can we provide?',
    a: 'Accepted delivery terms: FOB, CFR, CIF, EXW, Express Delivery. Accepted payment currencies: USD, CNY. Accepted payment types: T/T, L/C, Western Union, Cash. Languages spoken: English, Chinese.',
  },
];

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${SITE.url}/#webpage`,
    url: SITE.url,
    name: seo.title || `${SITE.brand} — ${SITE.tagline}`,
    description: seo.description,
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: { '@id': `${SITE.url}/#organization` },
  },
  {
    '@type': 'ItemList',
    name: 'Cosmetic pump product families',
    itemListElement: PRODUCT_CATEGORIES.map((family, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: family.label,
      url: new URL(`/product-category/${family.slug}/`, SITE.url).toString(),
    })),
  },
];
---

<BaseLayout
  title={seo.title || `${SITE.tagline} & Lotion Pump Supplier | ${SITE.brand}`}
  description={seo.description ||
    'Factory-direct cosmetic pump manufacturer in Cixi, Ningbo, China. Lotion pumps, fine mist sprayers, foam pumps, trigger sprayers and disc caps. ISO 9001:2015, MOQ 10,000 pcs.'}
  canonicalPath={path}
  schema={schema}
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg" style={`background-image: url(${HERO_POSTER})`} aria-hidden="true"></div>
    <div class="container-x hero-inner">
      <span class="eyebrow text-accent-bright">Company since {SITE.established}</span>
      <h1>{SITE.tagline}</h1>
      <p class="lede">
        Fine mist sprayers · lotion pumps · foam pumps · trigger sprayers — engineered and
        assembled in-house at our Cixi, Ningbo factory. ISO 9001:2015 certified.
      </p>
      <div class="hero-cta">
        <a href="#quote" class="btn btn-lg">Get a Quote</a>
        <a href="#families" class="btn btn-lg btn-ghost border-white/40 text-white hover:bg-white/10 hover:text-white">Browse products</a>
      </div>
      <dl class="hero-stats">
        {TRUST_STATS.map((stat) => (
          <div>
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Intro statement -->
  <section class="container-x py-24">
    <div class="split" data-reveal>
      <div>
        <span class="num">01</span>
        <h2 class="mt-4">Your OEM cosmetic pump manufacturer — factory direct from China</h2>
        <p class="mt-5 leading-relaxed text-muted">
          {SITE.legalName} (brand: <strong class="text-ink">{SITE.brand}</strong>) is a B2B cosmetic pump
          manufacturer in Cixi, Ningbo, Zhejiang — 30 minutes from Ningbo Port. We specialise in fine mist
          sprayers, lotion pumps, foam pumps, trigger sprayers, disc caps, oil pumps and treatment pumps.
        </p>
        <ul class="mt-6 space-y-2.5 text-sm text-ink/80">
          <li class="flex gap-2.5"><span class="mt-0.5 grid size-4 shrink-0 place-items-center rounded-full bg-brand-soft text-[10px] font-bold text-brand">✓</span>ISO 9001:2015 certified · SGS-tested products</li>
          <li class="flex gap-2.5"><span class="mt-0.5 grid size-4 shrink-0 place-items-center rounded-full bg-brand-soft text-[10px] font-bold text-brand">✓</span>MOQ 10,000 pcs · lead time 15–30 days</li>
          <li class="flex gap-2.5"><span class="mt-0.5 grid size-4 shrink-0 place-items-center rounded-full bg-brand-soft text-[10px] font-bold text-brand">✓</span>Full OEM/ODM — colour, material, finish, dosage</li>
        </ul>
      </div>
      <img
        src="https://sunshine-lotionpump.com/wp-content/uploads/sites/2/2026/05/all-closures-overview.png"
        alt={`${SITE.brand} closures and pumps product overview`}
        width="620"
        height="620"
        loading="lazy"
        decoding="async"
      />
    </div>
  </section>

  <!-- Product families -->
  <section id="families" class="border-y border-line bg-surface-alt py-24">
    <div class="container-x">
      <div class="section-head flex flex-wrap items-end justify-between gap-6" data-reveal>
        <div>
          <span class="num">02</span>
          <h2 class="mt-4">Nine product families, one factory</h2>
          <span class="rule" aria-hidden="true"></span>
        </div>
        <a href="/products/" class="link font-semibold">View the full catalogue →</a>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          families.map((family, index) => (
            <a
              href={`/product-category/${family.slug}/`}
              class="card group flex items-center gap-4 p-4"
              data-reveal
            >
              {family.image && (
                <img
                  src={family.image}
                  alt={family.label}
                  width="96"
                  height="96"
                  loading="lazy"
                  decoding="async"
                  class="size-20 shrink-0 rounded-lg border border-line bg-white object-contain p-1.5"
                />
              )}
              <span class="min-w-0">
                <span class="block font-display text-[15px] font-bold text-brand">{family.label}</span>
                <span class="mt-0.5 block text-xs text-muted">{family.count} products</span>
              </span>
              <svg class="ml-auto size-4 shrink-0 text-faint transition group-hover:translate-x-1 group-hover:text-accent" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Why choose us -->
  <section class="container-x py-24">
    <div class="section-head" data-reveal>
      <span class="num">03</span>
      <h2 class="mt-4">Why 100+ global beauty brands choose {SITE.brand}</h2>
      <span class="rule" aria-hidden="true"></span>
    </div>
    <div class="grid gap-5 lg:grid-cols-3">
      {
        why.map((item) => (
          <article class="card p-7" data-reveal>
            <span class="num">{item.num}</span>
            <h3 class="mt-4">{item.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-muted">{item.body}</p>
            <ul class="mt-5 space-y-2 border-t border-line pt-5 text-sm">
              {item.points.map((point) => (
                <li class="flex gap-2.5">
                  <span class="mt-0.5 grid size-4 shrink-0 place-items-center rounded-full bg-brand-soft text-[10px] font-bold text-brand">✓</span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Stats -->
  <section class="border-y border-line bg-brand-strong py-20 text-white">
    <div class="container-x">
      <div class="stat-grid" data-reveal>
        {
          stats.map((stat) => (
            <div class="stat">
              <div class="stat-value">{stat.value} <em>{stat.unit}</em></div>
              <div class="stat-label !text-white/60">{stat.label}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Certifications -->
  <section class="container-x py-24">
    <div class="section-head" data-reveal>
      <span class="num">04</span>
      <h2 class="mt-4">Certified for global markets</h2>
      <span class="rule" aria-hidden="true"></span>
    </div>
    <div class="grid grid-cols-2 gap-5 lg:grid-cols-4">
      {
        certifications.map((src, index) => (
          <img
            src={src}
            alt={`${SITE.brand} certification document ${index + 1}`}
            width="420"
            height="560"
            loading="lazy"
            decoding="async"
            class="card h-full w-full object-contain p-3"
            data-reveal
          />
        ))
      }
    </div>
  </section>

  <!-- Catalog -->
  <section class="container-x pb-24">
    <div class="card grid items-center gap-8 overflow-hidden p-8 lg:grid-cols-[1.3fr_1fr]" data-reveal>
      <div>
        <span class="num">05</span>
        <h2 class="mt-4">Download the full product catalogue</h2>
        <p class="mt-4 max-w-xl leading-relaxed text-muted">
          Complete specifications of all 9 product families — lotion pumps, foam pumps, fine mist
          sprayers, trigger sprayers, disc caps and more. Dimensions, material options, neck sizes,
          dosage charts and MOQ details in one PDF.
        </p>
        <a href={CATALOG_PDF} target="_blank" rel="noopener" class="btn mt-7">Download free catalogue</a>
      </div>
      <img
        src="https://sunshine-lotionpump.com/wp-content/uploads/sites/2/2026/07/xyc.png"
        alt="SUNSHINE cosmetic pump catalogue preview"
        width="720"
        height="480"
        loading="lazy"
        decoding="async"
        class="w-full rounded-xl border border-line object-cover"
      />
    </div>
  </section>

  <FaqList items={faqs} title="Frequently asked questions" />

  <!-- Quote -->
  <section id="quote" class="scroll-mt-20 bg-brand-strong py-24 text-white">
    <div class="container-x grid gap-12 lg:grid-cols-2">
      <div data-reveal>
        <span class="eyebrow text-accent-bright">Reply within 24 hours</span>
        <h2 class="mt-3 text-white">Ready for factory-direct cosmetic pump pricing?</h2>
        <p class="mt-5 max-w-xl leading-relaxed text-white/80">
          Skip the middlemen. We've manufactured spray pumps and dispensers since {SITE.established} —
          tell us your specs and get honest factory pricing within 24 hours.
        </p>
        <p class="mt-7 text-sm font-bold uppercase tracking-wide text-accent-bright">Zero-risk guarantee</p>
        <ul class="mt-3 space-y-2.5 text-sm text-white/85">
          <li>✔ Quality issues? We remake for free</li>
          <li>✔ Late delivery? 5% discount on next order</li>
          <li>✔ Not satisfied? We resolve it — no excuses, no delays</li>
          <li>✔ Customer satisfaction priority</li>
        </ul>
        <ul class="mt-7 space-y-2.5 border-t border-white/15 pt-7 text-sm">
          <li><a href={`mailto:${CONTACT.email}`} class="text-accent-bright hover:text-white">✉ {CONTACT.email}</a></li>
          <li><a href={CONTACT.phoneHref} class="text-accent-bright hover:text-white">☎ Call us: {CONTACT.phoneDisplay}</a></li>
          <li><a href={CONTACT.whatsappHref} rel="noopener" class="text-accent-bright hover:text-white">WhatsApp: {CONTACT.whatsappDisplay}</a></li>
          <li class="text-white/60">{CONTACT.addressOneLine}</li>
        </ul>
      </div>
      <div class="card p-8" data-reveal>
        <LeadForm variant="site" source="home-quote" submitLabel="Get Your Factory-Direct Quote" />
      </div>
    </div>
  </section>
</BaseLayout>
