---
/**
 * Home page — re-authored from the legacy Elementor layout.
 * Copy is preserved; the layout is rebuilt with semantic HTML + Tailwind.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import LeadForm from '@/components/LeadForm.astro';
import ProductCard from '@/components/ProductCard.astro';
import FaqList from '@/components/FaqList.astro';
import { PRODUCT_CATEGORIES, SITE, CONTACT, TRUST_STATS } from '@/config/site';
import { seoFor } from '@/lib/content';

const products = await getCollection('products');
const path = '/';
const seo = seoFor(path);

const CATALOG_PDF =
  'https://sunshine-lotionpump.com/wp-content/uploads/sites/2/2026/07/Sunshine-Catalog.pdf';

const HERO_IMAGES = [
  'https://sunshine-lotionpump.com/wp-content/uploads/sites/2/2026/04/5144be47754aa59e90ee0abfb3ad7337.webp',
  'https://sunshine-lotionpump.com/wp-content/uploads/sites/2/2026/04/748b806b4ade9bd47e714b0b61e17360.webp',
];

const highlights = [
  { title: 'Premium Quality', text: 'ISO 9001:2015 certified production' },
  { title: 'Fast Turnaround', text: '15–20 day standard lead time' },
  { title: 'Competitive Pricing', text: 'Factory-direct pricing, no middlemen' },
  { title: 'Low MOQ', text: 'Orders from 10,000 pcs' },
  { title: 'Flexible Production', text: 'Full customisation available' },
];

const pillars = [
  {
    tag: 'Manufacturing Excellence',
    title: '7+ years of plastic pump manufacturing',
    body: 'Our 7,000 m² cosmetic pump facility runs 20 assembly machines and 2 automated assembly lines — factory-direct quality at wholesale prices.',
    points: [
      '50M+ spray pumps produced annually with consistent quality',
      'Perfect safety record with a comprehensive quality tracking system',
    ],
  },
  {
    tag: 'Precision Standards',
    title: 'Factory quality standards',
    body: 'ISO 9001:2015 certified manufacturer. An in-house testing lab ensures every spray pump meets international standards for the US, EU and global markets.',
    points: [
      '±0.1 mm dimensional accuracy guaranteed',
      'Triple quality inspection before shipment',
      '24-hour aging test for durability validation',
    ],
  },
  {
    tag: 'Fast Delivery',
    title: 'Fast & reliable delivery, guaranteed',
    body: 'Direct cosmetic pump manufacturer with in-house mould making. No intermediaries — your order goes straight to our factory floor.',
    points: [
      '15–20 days standard, 12-day rush available',
      '99.8% on-time delivery rate',
      'Direct factory pricing saves 10–30%',
    ],
  },
];

const certifications = [
  'https://sunshine-lotionpump.com/wp-content/uploads/sites/2/2026/07/SGS1.png',
  'https://sunshine-lotionpump.com/wp-content/uploads/sites/2/2026/07/SGS2.png',
  'https://sunshine-lotionpump.com/wp-content/uploads/sites/2/2026/07/SGS3.png',
  'https://sunshine-lotionpump.com/wp-content/uploads/sites/2/2026/07/ISO-9001-Quality-Certifications.jpg',
];

const faqs = [
  {
    q: 'Who are we?',
    a: 'We are based in Cixi, Ningbo, Zhejiang, China, operating since 2018. We sell to the domestic market (50%), the Middle East (15%), North America (5%), South America (5%), Southeast Asia (5%), Oceania (5%), Eastern Asia (5%), Northern Europe (5%) and South Asia (5%).',
  },
  {
    q: 'How can we guarantee quality?',
    a: 'Always a pre-production sample before mass production; always a final inspection before shipment.',
  },
  {
    q: 'What can you buy from us?',
    a: 'Lotion pumps, trigger sprayers, mist sprayers, cream pumps and caps.',
  },
  {
    q: 'Why should you buy from us and not from other suppliers?',
    a: 'Competitive price, good quality and a reliable delivery time.',
  },
  {
    q: 'What services can we provide?',
    a: 'Accepted delivery terms: FOB, CFR, CIF, EXW, Express Delivery. Accepted payment currencies: USD, CNY. Accepted payment types: T/T, L/C, Western Union, Cash. Languages spoken: English, Chinese.',
  },
];

/** two products per family, up to 12, for the filterable grid */
const featured = [];
for (const category of PRODUCT_CATEGORIES) {
  const inFamily = products.filter((p) => p.data.categories.includes(category.slug));
  featured.push(...inFamily.slice(0, 2));
}
const featuredProducts = featured.slice(0, 12).slice(0, 18);

const families = PRODUCT_CATEGORIES.filter((c) =>
  featuredProducts.some((p) => p.data.categories.includes(c.slug)),
);

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${SITE.url}/#webpage`,
    url: SITE.url,
    name: seo.title || `${SITE.brand} — ${SITE.tagline}`,
    description: seo.description,
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: { '@id': `${SITE.url}/#organization` },
  },
  {
    '@type': 'ItemList',
    name: 'Cosmetic pump product families',
    itemListElement: PRODUCT_CATEGORIES.map((family, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: family.label,
      url: new URL(`/product-category/${family.slug}/`, SITE.url).toString(),
    })),
  },
];
---

<BaseLayout
  title={seo.title || `${SITE.tagline} & Lotion Pump Supplier | ${SITE.brand}`}
  description={seo.description ||
    'Factory-direct cosmetic pump manufacturer in Cixi, Ningbo, China. Lotion pumps, fine mist sprayers, foam pumps, trigger sprayers and disc caps. ISO 9001:2015, MOQ 10,000 pcs.'}
  canonicalPath={path}
  schema={schema}
>
  <!-- Hero -->
  <section class="bg-brand text-white">
    <div class="container-x grid items-center gap-10 py-14 lg:grid-cols-2 lg:py-20">
      <div>
        <span class="eyebrow text-accent-bright">Company since {SITE.established}</span>
        <h1 class="mt-3 text-white">{SITE.tagline}</h1>
        <p class="mt-5 max-w-xl text-lg text-white/85">
          Fine mist sprayers · lotion pumps · foam pumps · trigger sprayers — all made in-house in
          Cixi, Ningbo, China.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="#quote" class="btn btn-lg">Get a Quote</a>
          <a href="#products" class="btn btn-ghost btn-lg border-white/30 bg-transparent text-white hover:bg-white/10">
            Browse products
          </a>
        </div>
        <dl class="mt-9 grid max-w-md grid-cols-3 gap-4">
          {
            TRUST_STATS.map((stat) => (
              <div>
                <dt class="text-[11px] uppercase tracking-wide text-white/60">{stat.label}</dt>
                <dd class="text-xl font-black text-accent-bright">{stat.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
        {
          HERO_IMAGES.map((src, index) => (
            <img
              src={src}
              alt={index === 0 ? 'Fine mist sprayers and lotion pumps manufactured by SUNSHINE' : 'Cosmetic pump assembly line at the Cixi factory'}
              width="640"
              height="420"
              loading="eager"
              decoding="async"
              class:list={[
                'w-full rounded-xl object-cover shadow-2xl',
                index === 1 ? 'hidden sm:block' : '',
              ]}
            />
          ))
        }
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="container-x py-14">
    <div class="grid gap-8 lg:grid-cols-[1.4fr_1fr]">
      <div>
        <h2>Your OEM cosmetic pump manufacturer — factory direct from China</h2>
        <p class="mt-4 text-ink/75">
          {SITE.legalName} (brand: <strong>{SITE.brand}</strong>) is a B2B cosmetic pump manufacturer
          in Cixi, Ningbo, Zhejiang — 30 minutes from Ningbo Port. We specialise in fine mist
          sprayers, lotion pumps, foam pumps, trigger sprayers, disc caps, oil pumps and treatment
          pumps. ISO 9001:2015 certified. MOQ 10,000 pcs. Lead time 15–30 days. Full OEM/ODM
          available.
        </p>
      </div>
      <div class="card flex flex-col justify-between gap-4 p-6">
        <p class="text-sm text-muted">
          Need pricing today? Send your spec and we reply within one business day.
        </p>
        <a href="#quote" class="btn">GET A QUOTE</a>
      </div>
    </div>
  </section>

  <!-- Solutions -->
  <section class="bg-surface py-14">
    <div class="container-x">
      <h2>OEM/ODM cosmetic pump &amp; dispenser solutions</h2>
      <p class="mt-2 text-sm font-semibold uppercase tracking-wide text-accent">
        Factory direct — Cixi, Ningbo, Zhejiang China
      </p>
      <p class="mt-4 max-w-3xl text-ink/75">
        Different products need different dispensing mechanisms. Fine mist for skincare serums, foam
        for hand wash, lotion pumps for body care, trigger sprayers for household use — we
        manufacture them all in-house. Tell us your application and we'll engineer the right
        solution. All pumps are manufactured at our 7,000 m² Cixi factory under ISO 9001:2015
        quality control.
      </p>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        {
          highlights.map((item) => (
            <li class="card p-5">
              <h3 class="text-base">{item.title}</h3>
              <p class="mt-1 text-sm text-muted">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Products -->
  <section id="products" class="container-x scroll-mt-24 py-14">
    <h2>Cosmetic dispensing pumps &amp; closures</h2>
    <p class="mt-2 text-sm text-muted">
      {products.length} standard products across {PRODUCT_CATEGORIES.length} families — every one
      available in custom OEM/ODM configuration.
    </p>

    <div class="mt-6 flex flex-wrap gap-2" data-product-filter>
      <button type="button" class="btn text-sm" data-filter="all" aria-pressed="true">All</button>
      {
        families.map((family) => (
          <button
            type="button"
            class="btn btn-ghost text-sm"
            data-filter={family.slug}
            aria-pressed="false"
          >
            {family.label}
          </button>
        ))
      }
    </div>

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-product-grid>
      {
        featuredProducts.map((product, index) => (
          <div data-product-category={product.data.categories.join(' ')}>
            <ProductCard product={product.data} eager={index < 3} />
          </div>
        ))
      }
    </div>
  </section>

  <!-- Why us -->
  <section class="bg-surface py-14">
    <div class="container-x">
      <h2>Why 100+ global beauty brands choose {SITE.brand}</h2>
      <p class="mt-4 max-w-3xl text-ink/75">
        Over 100 beauty and personal care brands — from indie startups to large-scale OEM clients
        across the Middle East, Africa, Southeast Asia and North America — source their pumps
        directly from our factory. Here's what keeps them coming back.
      </p>

      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {
          pillars.map((pillar) => (
            <article class="card p-6">
              <span class="eyebrow">{pillar.tag}</span>
              <h3 class="mt-2">{pillar.title}</h3>
              <p class="mt-3 text-sm text-ink/75">{pillar.body}</p>
              <ul class="mt-4 space-y-2 text-sm">
                {pillar.points.map((point) => (
                  <li class="flex gap-2">
                    <span class="text-accent" aria-hidden="true">✔</span>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Certifications -->
  <section class="container-x py-14">
    <h2>Our quality certifications</h2>
    <p class="mt-4 max-w-3xl text-ink/75">
      {SITE.brand} is ISO 9001:2015 certified and conducts SGS testing on our cosmetic pumps and
      dispensers to ensure every product meets international import standards for the US, EU and
      global markets.
    </p>
    <div class="mt-8 grid grid-cols-2 gap-4 lg:grid-cols-4">
      {
        certifications.map((src, index) => (
          <img
            src={src}
            alt={`${SITE.brand} certification document ${index + 1}`}
            width="400"
            height="520"
            loading="lazy"
            decoding="async"
            class="card h-full w-full object-contain p-2"
          />
        ))
      }
    </div>
  </section>

  <!-- Catalog -->
  <section class="bg-brand-strong py-14 text-white">
    <div class="container-x grid items-center gap-10 lg:grid-cols-2">
      <div>
        <h2 class="text-white">Download our product catalog</h2>
        <p class="mt-3 text-white/80">
          Complete specifications of all 9 product families — lotion pumps, foam pumps, fine mist
          sprayers, trigger sprayers, disc caps and more. All in one convenient PDF.
        </p>
        <ul class="mt-5 space-y-2 text-sm text-white/85">
          <li>✔ Full product specifications &amp; dimensions</li>
          <li>✔ Material options (PP, aluminium, PET, bamboo)</li>
          <li>✔ Neck size &amp; dosage charts</li>
          <li>✔ Customisation options &amp; MOQ details</li>
        </ul>
        <a href={CATALOG_PDF} target="_blank" rel="noopener" class="btn mt-6">
          Download free catalog
        </a>
      </div>
      <img
        src="https://sunshine-lotionpump.com/wp-content/uploads/sites/2/2026/07/xyc.png"
        alt="SUNSHINE cosmetic pump catalogue preview"
        width="720"
        height="480"
        loading="lazy"
        decoding="async"
        class="w-full rounded-xl object-cover shadow-xl"
      />
    </div>
  </section>

  <!-- About + FAQ -->
  <section class="container-x py-14">
    <h2>Your custom cosmetic pump &amp; dispenser manufacturer</h2>
    <p class="mt-4 max-w-3xl text-ink/75">
      One manufacturer, full service. From pump design and mould making to assembly, QC and export
      shipping — all under one roof in Cixi, Ningbo, China.
    </p>
  </section>

  <FaqList items={faqs} title="Frequently asked questions" />

  <!-- Quote -->
  <section id="quote" class="scroll-mt-20 bg-brand py-16 text-white">
    <div class="container-x grid gap-10 lg:grid-cols-2">
      <div>
        <span class="eyebrow text-accent-bright">Reply within 24 hours</span>
        <h2 class="mt-2 text-white">Ready for factory-direct cosmetic pump pricing?</h2>
        <p class="mt-4 text-white/80">
          Skip the middlemen. We've manufactured spray pumps and dispensers since {SITE.established} —
          tell us your specs and get honest factory pricing within 24 hours.
        </p>

        <p class="mt-6 text-sm font-bold uppercase tracking-wide text-accent-bright">
          Zero-risk guarantee
        </p>
        <ul class="mt-3 space-y-2 text-sm text-white/85">
          <li>✔ Quality issues? We remake for free</li>
          <li>✔ Late delivery? 5% discount on next order</li>
          <li>✔ Not satisfied? We resolve it — no excuses, no delays</li>
          <li>✔ Customer satisfaction priority</li>
        </ul>

        <ul class="mt-6 space-y-2 text-sm">
          <li><a href={`mailto:${CONTACT.email}`} class="text-accent-bright hover:text-white">✉ {CONTACT.email}</a></li>
          <li><a href={CONTACT.phoneHref} class="text-accent-bright hover:text-white">☎ Call us: {CONTACT.phoneDisplay}</a></li>
          <li><a href={CONTACT.whatsappHref} rel="noopener" class="text-accent-bright hover:text-white">WhatsApp: {CONTACT.whatsappDisplay}</a></li>
          <li class="text-white/70">Response: within 24 hours guaranteed</li>
        </ul>
      </div>

      <div class="rounded-xl bg-white p-6 shadow-xl">
        <h2 class="text-xl">Get your factory-direct quote</h2>
        <p class="mt-1 text-sm text-muted">
          Share your requirements — pump type, size, volume and quantity. We'll respond within 24
          hours with factory pricing and a sample recommendation.
        </p>
        <div class="mt-4">
          <LeadForm variant="site" source="home-quote" submitLabel="Get Your Factory-Direct Quote" />
        </div>
      </div>
    </div>
  </section>

  <script>
    const wrapper = document.querySelector<HTMLElement>('[data-product-filter]');
    const grid = document.querySelector<HTMLElement>('[data-product-grid]');
    if (wrapper && grid) {
      const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-product-category]'));
      wrapper.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
        if (!button) return;
        const filter = button.dataset.filter ?? 'all';
        wrapper.querySelectorAll('button').forEach((b) => {
          const active = b === button;
          b.setAttribute('aria-pressed', String(active));
          b.classList.toggle('btn-ghost', !active);
        });
        cards.forEach((card) => {
          const categories = card.dataset.productCategory ?? '';
          card.hidden = filter !== 'all' && !categories.split(' ').includes(filter);
        });
      });
    }
  </script>
</BaseLayout>
