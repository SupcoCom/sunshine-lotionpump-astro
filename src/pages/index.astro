---
/**
 * Home — professional B2B manufacturer homepage.
 * Clean, trustworthy, conversion-focused. Clear information hierarchy,
 * real factory proof, and a calm corporate aesthetic.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import LeadForm from '@/components/LeadForm.astro';
import FaqList from '@/components/FaqList.astro';
import { PRODUCT_CATEGORIES, SITE, CONTACT, TRUST_STATS } from '@/config/site';
import { seoFor } from '@/lib/content';

const products = await getCollection('products');
const path = '/';
const seo = seoFor(path);

const CATALOG_PDF =
  'https://admin.sunshine-lotionpump.com/wp-content/uploads/sites/2/2026/07/Sunshine-Catalog.pdf';

const families = PRODUCT_CATEGORIES.map((family) => {
  const inFamily = products.filter((p) => p.data.categories.includes(family.slug));
  return { ...family, count: inFamily.length, image: inFamily[0]?.data.image || '' };
}).filter((f) => f.count > 0);

const FAMILY_COUNT = families.length;
const FAMILY_WORD = FAMILY_COUNT === 1 ? 'family' : 'families';

const ASSEMBLY_LINES = 4;
const LEAD_TIME = '15–30 days';
const FACTORY_FLOOR = '7,000';

const productShowcase = [
  {
    title: 'Lotion Pumps',
    desc: '24/410 · 28/410 · 33/410 neck sizes',
    image: '/img/products/pump-large-body.webp',
    image1x: '/img/products/pump-large-body-1x.webp',
    href: '/product-category/lotion-pump/',
  },
  {
    title: 'Trigger Sprayers',
    desc: '28/400 · 28/410 square & round',
    image: '/img/products/trigger-sprayer-square-nozzle.webp',
    image1x: '/img/products/trigger-sprayer-square-nozzle-1x.webp',
    href: '/product-category/trigger-sprayers/',
  },
  {
    title: 'Fine Mist Sprayers',
    desc: '18/415 · 20/410 · 24/410',
    image: '/img/products/sprayer-fine-mist.webp',
    image1x: '/img/products/sprayer-fine-mist-1x.webp',
    href: '/product-category/fine-mist-sprayer/',
  },
  {
    title: 'Foam Pumps',
    desc: '30/400 · 40/400 · 43/400',
    image: '/img/products/pump-powder.webp',
    image1x: '/img/products/pump-powder-1x.webp',
    href: '/product-category/foam-pump/',
  },
  {
    title: 'Cream Pumps',
    desc: '24/410 · 28/410 · 33/410 · airless',
    image: 'https://admin.sunshine-lotionpump.com/wp-content/uploads/sites/2/2026/05/prod-0-1777613486521.webp',
    href: '/product-category/cream-pump/',
  },
  {
    title: 'Treatment Pumps',
    desc: '18/410 · 20/410 · 24/410',
    image: 'https://admin.sunshine-lotionpump.com/wp-content/uploads/sites/2/2026/05/prod-0-1777706961288.webp',
    href: '/product-category/treatment-pump/',
  },
  {
    title: 'Nail Polish Pumps',
    desc: '15/410 · custom crimp',
    image: '/img/products/trigger-rf-plastic.jpg',
    href: '/product-category/nail-polish-pump/',
  },
  {
    title: 'Disc Top Caps',
    desc: '24/410 · 28/410 · flip top',
    image: '/img/products/lotion-pump-locking-switch.jpg',
    href: '/product-category/disc-top-cap/',
  },
];

const stats = [
  { value: '50M+', num: 50, suffix: 'M+', label: 'Pumps produced / year' },
  { value: FACTORY_FLOOR, num: 7000, suffix: ' m²', label: 'Factory floor' },
  { value: '10+', num: 10, suffix: '+', label: 'Injection machines' },
  { value: String(ASSEMBLY_LINES), num: ASSEMBLY_LINES, suffix: '', label: 'Assembly lines' },
  { value: '5,000', num: 5000, suffix: '', label: 'MOQ (pcs)' },
];

const capabilities = [
  {
    title: 'In-house moulding',
    body: 'Pump bodies, caps and closures moulded on site for full control of cost and quality.',
    icon: 'factory',
  },
  {
    title: 'OEM / ODM service',
    body: 'Custom colour, material, finish and dosage to match your brand exactly.',
    icon: 'edit',
  },
  {
    title: 'Third-party inspection',
    body: 'Pre-production samples and final AQL sampling with independent reports available.',
    icon: 'shield',
  },
];

const whyPillars = [
  {
    num: '01',
    title: 'Manufacturing excellence',
    lead: 'Our 7,000 m² facility runs 20 assembly machines and automated lines — factory-direct quality at wholesale prices.',
    points: [
      '50M+ spray pumps produced annually',
      'ISO 9001:2015 certified quality management',
      '24/7 automated production capability',
      'Perfect safety record with full quality tracking',
    ],
  },
  {
    num: '02',
    title: 'Precision standards',
    lead: 'In-house testing lab ensures every pump meets international standards for the US, EU and global markets.',
    points: [
      '±0.1mm dimensional accuracy guaranteed',
      'Triple inspection at material, production & packaging',
      '24-hour aging test for durability validation',
      'Automated quality control on every production run',
    ],
  },
  {
    num: '03',
    title: 'Fast, reliable delivery',
    lead: 'Direct manufacturer with in-house mould making. No intermediaries — your order goes straight to the factory floor.',
    points: [
      '15–20 days standard, 12-day rush available',
      '99.8% on-time delivery across 100+ global clients',
      'Direct factory pricing saves you 10–30%',
      'Reliable supply chain for product launches',
    ],
  },
];

const valueCards = [
  { title: 'Premium quality', desc: 'ISO 9001 certified production with in-house testing.' },
  { title: 'Fast turnaround', desc: '15-day standard lead time, rush orders supported.' },
  { title: 'Competitive pricing', desc: 'Factory-direct pricing with no middlemen markup.' },
  { title: 'Low MOQ & flexible', desc: 'Orders from 5,000 pcs with full customization.' },
];

const certifications = [
  '/img/new/证书/ISO-9001-Quality-Certifications.jpg',
  '/img/new/证书/SGS1.png',
  '/img/new/证书/SGS2.png',
  '/img/new/证书/SGS3.png',
];

const faqs = [
  {
    q: 'Who are we?',
    a: 'We are based in Yuyao, Ningbo, Zhejiang, China, operating since 2018. We sell to the domestic market (50%), the Middle East (15%), North America (5%), South America (5%), Southeast Asia (5%), Oceania (5%), Eastern Asia (5%), Northern Europe (5%) and South Asia (5%).',
  },
  {
    q: 'How can we guarantee quality?',
    a: 'Always a pre-production sample before mass production; always a final inspection before shipment.',
  },
  {
    q: 'What can you buy from us?',
    a: 'Lotion pumps, trigger sprayers, mist sprayers, cream pumps and caps.',
  },
  {
    q: 'Why should you buy from us and not from other suppliers?',
    a: 'Competitive price, good quality and a reliable delivery time.',
  },
  {
    q: 'What services can we provide?',
    a: 'Accepted delivery terms: FOB, CFR, CIF, EXW, Express Delivery. Accepted payment currencies: USD, CNY. Accepted payment types: T/T, L/C, Western Union, Cash. Languages spoken: English, Chinese.',
  },
];

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${SITE.url}/#webpage`,
    url: SITE.url,
    name: seo.title || `${SITE.brand} — ${SITE.tagline}`,
    description: seo.description,
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: { '@id': `${SITE.url}/#organization` },
  },
  {
    '@type': 'ItemList',
    name: 'Cosmetic pump product families',
    itemListElement: families.map((family, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: family.label,
      url: new URL(`/product-category/${family.slug}/`, SITE.url).toString(),
    })),
  },
];
---

<BaseLayout
  title={seo.title || `${SITE.brand} — Lotion Pump & Sprayer Manufacturer in China`}
  description={seo.description ||
    'ISO 9001:2015 certified manufacturer of lotion pumps, trigger sprayers, fine mist sprayers and foam pumps in Yuyao, Ningbo, China. Factory-direct pricing, 50M+ units/year.'}
  canonicalPath={path}
  schema={schema}
>
  <!-- 1. HERO — left copy / right factory image -->
  <section class="p-hero">
    <div class="p-hero-bg" aria-hidden="true">
      <img
        src="https://img.supcous.com/2026/04/21dec35f4422a9b46ecd7d43d392cb38.webp"
        alt=""
        loading="eager"
        decoding="async"
      />
    </div>
    <span class="p-hero-glow" aria-hidden="true"></span>
    <span class="p-hero-gridlines" aria-hidden="true"></span>
    <span class="p-hero-index" aria-hidden="true">01</span>
    <div class="container-x p-hero-grid">
      <div class="p-hero-copy">
        <div class="p-eyebrow a-rise" style="--d:0ms">
          <span class="p-eyebrow-dot"></span>
          {SITE.legalName} · Since {SITE.established}
        </div>
        <h1 class="p-hero-title a-rise" style="--d:80ms">
          Cosmetic pump &amp; sprayer manufacturer in China
        </h1>
        <p class="p-hero-lede a-rise" style="--d:160ms">
          Factory-direct lotion pumps, trigger sprayers, fine mist sprayers and foam pumps for
          beauty, personal care and cleaning brands. ISO 9001:2015 certified. 50M+ units every year.
        </p>
        <div class="p-hero-actions a-rise" style="--d:240ms">
          <a href="#quote" class="btn btn-lg">Request a quote</a>
          <a href="#products" class="btn btn-lg btn-ghost-light">Browse products</a>
        </div>
        <dl class="p-hero-stats a-rise" style="--d:320ms">
          {TRUST_STATS.map((s) => (
            <div class="p-hero-stat">
              <dt>{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="p-hero-media a-rise" style="--d:200ms">
        <div class="p-hero-photo">
          <span class="p-hero-photo-ring" aria-hidden="true"></span>
          <img
            src="/img/hero-product-transparent.webp"
            alt="Automated assembly line at our Ningbo factory"
            width="640"
            height="640"
            loading="eager"
            decoding="async"
          />
          <div class="p-hero-badge">
            <strong>{ASSEMBLY_LINES} automated</strong>
            <span>assembly lines</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. TRUST STRIP -->
  <section class="p-strip">
    <div class="container-x p-strip-inner">
      <span class="p-strip-item">ISO 9001:2015</span>
      <span class="p-strip-sep"></span>
      <span class="p-strip-item">SGS tested</span>
      <span class="p-strip-sep"></span>
      <span class="p-strip-item">OEM / ODM</span>
      <span class="p-strip-sep"></span>
      <span class="p-strip-item">FOB · CIF · EXW</span>
      <span class="p-strip-sep"></span>
      <span class="p-strip-item">Reply in 24 hrs</span>
    </div>
  </section>

  <!-- 3. PRODUCTS -->
  <section id="products" class="p-section p-bg-grid">
    <div class="container-x">
      <div class="p-head p-head-editorial" data-reveal>
        <span class="p-kicker">Our products</span>
        <h2 class="p-title p-title-xl">The full range of<br /><em>cosmetic dispensing pumps</em></h2>
        <p class="p-sub">{FAMILY_COUNT} product families, one factory. Custom colour, material and dosage on request.</p>
      </div>

      <div class="p-products p-products-offset">
        {productShowcase.map((item, i) => (
          <a href={item.href} class="p-product" data-reveal style={`--d:${(i % 3) * 90}ms`}>
            <div class="p-product-img">
              <img
                src={item.image1x || item.image}
                srcset={`${item.image1x || item.image} 1x, ${item.image} 2x`}
                alt={item.title}
                width="550"
                height="550"
                loading="lazy"
                decoding="async"
              />
              <span class="p-product-arrow" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
            </div>
            <div class="p-product-body">
              <span class="p-product-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          </a>
        ))}
      </div>

      <div class="p-center mt-16" data-reveal>
        <a href="/products/" class="btn btn-lg">View all {FAMILY_COUNT} product {FAMILY_WORD}</a>
      </div>
    </div>
  </section>

  <!-- 3b. VALUE CARDS — horizontal numbered index (not a grid) -->
  <section class="p-section p-bg-soft p-bg-diag">
    <div class="container-x">
      <div class="p-head p-head-editorial" data-reveal>
        <span class="p-kicker">Our commitment</span>
        <h2 class="p-title p-title-xl">What every order<br /><em>comes with</em></h2>
      </div>
      <ol class="p-value-list">
        {valueCards.map((card, i) => (
          <li class="p-value-row" data-reveal style={`--d:${i * 70}ms`}>
            <span class="p-value-idx">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="p-value-name">{card.title}</h3>
            <p class="p-value-desc">{card.desc}</p>
            <span class="p-value-mark" aria-hidden="true">→</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4. STATS — oversized data band -->
  <section class="p-stats">
    <div class="container-x p-stats-row">
      {stats.map((s, i) => (
        <div class="p-stat-item" data-reveal style={`--d:${i * 70}ms`}>
          <span class="p-stat-label">{s.label}</span>
          <span class="p-stat-value" data-count={s.num} data-suffix={s.suffix}>{s.value}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- 5. FACTORY / CAPABILITIES -->
  <section class="p-section p-bg-dots">
    <div class="container-x">
      <div class="p-head p-head-editorial" data-reveal>
        <span class="p-kicker">About the factory</span>
        <h2 class="p-title p-title-xl">A {FACTORY_FLOOR} m² plant<br /><em>built for consistent quality</em></h2>
      </div>
      <div class="p-split p-split-editorial">
        <div class="p-split-text" data-reveal="left">
          <p class="p-sub">
            Located in Yuyao, Ningbo — 30 minutes from Ningbo Port. We mould, assemble and inspect
            under one roof, cutting out trading-company margins.
          </p>
          <div class="p-caps">
            {capabilities.map((cap) => (
              <div class="p-cap" data-reveal>
                <span class="p-cap-icon">
                  {cap.icon === 'factory' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 20h20M4 20V8l6 3V8l6 3V4h4v16" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                  {cap.icon === 'edit' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5Z" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                  {cap.icon === 'shield' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z" stroke-linecap="round" stroke-linejoin="round"/><path d="m9 12 2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>}
                </span>
                <div>
                  <h3>{cap.title}</h3>
                  <p>{cap.body}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="p-split-media" data-reveal="right">
          <video
            src="https://cloud.video.alibaba.com/play/u/2153292369/p/1/e/6/t/1/d/hd/407602126837.mp4"
            poster="/img/new/生产车间/5273-hero.webp"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            aria-label="Inside our injection moulding facility"
          ></video>
        </div>
      </div>
    </div>
  </section>

  <!-- 5b. WHY 100+ BRANDS -->
  <section class="p-section p-bg-soft p-bg-lines">
    <div class="container-x">
      <div class="p-head p-head-editorial" data-reveal>
        <span class="p-kicker">Why us</span>
        <h2 class="p-title p-title-xl">Why 100+ global brands<br /><em>choose {SITE.brand}</em></h2>
        <p class="p-sub">Over 100 beauty and personal care brands — from indie startups to large OEM clients across the Middle East, Africa, Southeast Asia and North America — source pumps directly from our factory.</p>
      </div>
      <div class="p-why-stack">
        {whyPillars.map((pillar, i) => (
          <article class="p-why-block" data-reveal style={`--d:${i * 80}ms`}>
            <span class="p-why-block-num" aria-hidden="true">{pillar.num}</span>
            <div class="p-why-block-body">
              <h3>{pillar.title}</h3>
              <p class="p-why-lead">{pillar.lead}</p>
              <ul class="p-why-points">
                {pillar.points.map((point) => (
                  <li><span class="p-check">✓</span>{point}</li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. QUALITY & CERTIFICATIONS -->
  <section class="p-section p-bg-plus">
    <div class="container-x">
      <div class="p-head p-head-editorial" data-reveal>
        <span class="p-kicker">Quality assurance</span>
        <h2 class="p-title p-title-xl">Certified to<br /><em>international standards</em></h2>
        <p class="p-sub">Verifiable quality for the US, EU and Middle East markets — third-party reports available on request.</p>
      </div>
      <div class="p-qual p-qual-editorial" data-reveal>
        <div class="p-qual-certs">
          {certifications.map((src, i) => (
            <img
              src={src}
              alt={`${SITE.brand} certification ${i + 1}`}
              width="360"
              height="480"
              loading="lazy"
              decoding="async"
            />
          ))}
        </div>
        <div class="p-qual-list">
          <div class="p-qual-item"><span class="p-check">✓</span>ISO 9001:2015 quality management system</div>
          <div class="p-qual-item"><span class="p-check">✓</span>SGS material &amp; performance test reports</div>
          <div class="p-qual-item"><span class="p-check">✓</span>Pre-production sample approval</div>
          <div class="p-qual-item"><span class="p-check">✓</span>Leak, actuation &amp; dosage consistency checks</div>
          <div class="p-qual-item"><span class="p-check">✓</span>Final AQL inspection before every shipment</div>
        </div>
      </div>
    </div>
  </section>

  <!-- 7. SHIPPING -->
  <section class="p-section p-bg-dark p-bg-arc">
    <div class="container-x">
      <div class="p-head p-head-editorial" data-reveal>
        <span class="p-kicker p-kicker-light">Global shipping</span>
        <h2 class="p-title p-title-xl p-title-light">Delivered to buyers<br /><em>in 50+ countries</em></h2>
      </div>
      <div class="p-split p-split-editorial">
        <div class="p-split-media p-order-2" data-reveal="left">
          <img
            src="https://admin.sunshine-lotionpump.com/wp-content/uploads/sites/2/2026/04/Fastest-Delivery.jpg"
            alt="Export container loaded with shipments"
            width="640"
            height="480"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="p-split-text p-order-1" data-reveal="right">
          <p class="p-sub p-sub-light">
            We handle export packing, customs documentation and flexible delivery terms from our
            warehouse near Ningbo Port.
          </p>
          <div class="p-pills">
            <span class="p-pill">FOB / CFR / CIF / EXW</span>
            <span class="p-pill">Lead time {LEAD_TIME}</span>
            <span class="p-pill">MOQ 5,000 pcs</span>
            <span class="p-pill">T/T · L/C · Western Union</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. EXHIBITION -->
  <section class="p-section p-bg-soft p-bg-dots">
    <div class="container-x">
      <div class="p-head p-head-editorial" data-reveal>
        <span class="p-kicker">Trade exhibitions</span>
        <h2 class="p-title p-title-xl">Meet us<br /><em>in person</em></h2>
        <p class="p-sub">We exhibit at PCHi, Cosmoprof and regional packaging shows every year.</p>
      </div>
      <div class="p-expo" data-reveal>
        <div class="p-expo-main">
          <img
            src="/img/new/展会/expo-main.webp"
            alt={`${SITE.brand} exhibition booth`}
            width="900"
            height="600"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="p-expo-side">
          <img
            src="/img/new/展会/expo-side.webp"
            alt={`${SITE.brand} exhibition stand`}
            width="640"
            height="600"
            loading="lazy"
            decoding="async"
          />
          <div class="p-expo-card">
            <span class="p-expo-booth">Booth 4.1-H08G</span>
            <p>See samples, discuss your project and get on-site pricing.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 9. CATALOG CTA -->
  <section class="p-section">
    <div class="container-x">
      <div class="p-cta" data-reveal>
        <div class="p-cta-text">
          <span class="p-kicker">Catalogue</span>
          <h2 class="p-title p-title-xl">Download the<br /><em>full product catalogue</em></h2>
          <p class="p-sub">
            Specifications for all {FAMILY_COUNT} product {FAMILY_WORD}: dimensions, materials, neck sizes, dosage charts and MOQ.
          </p>
        </div>
        <a href={CATALOG_PDF} target="_blank" rel="noopener" class="btn btn-lg">Download PDF</a>
      </div>
    </div>
  </section>

  <FaqList items={faqs} title="Frequently asked questions" />

  <!-- 10. QUOTE -->
  <section id="quote" class="p-quote">
    <div class="container-x p-quote-grid">
      <div class="p-quote-text" data-reveal="left">
        <span class="p-kicker p-kicker-light">Get a quote</span>
        <h2 class="p-title p-title-xl p-title-light">Ready for<br /><em>factory-direct pricing?</em></h2>
        <p class="p-sub p-sub-light">
          Tell us your specs and get an honest quote within 24 hours. No middlemen.
        </p>
        <div class="p-quote-points">
          <div class="p-quote-point"><span class="p-check">✓</span>Quality issues remade free</div>
          <div class="p-quote-point"><span class="p-check">✓</span>Late delivery — 5% off next order</div>
          <div class="p-quote-point"><span class="p-check">✓</span>Pre-production samples before mass production</div>
        </div>
        <div class="p-quote-contact">
          <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
          <a href={CONTACT.phoneHref}>{CONTACT.phoneDisplay}</a>
          <a href={CONTACT.whatsappHref} rel="noopener">WhatsApp</a>
        </div>
      </div>
