---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ProductCard from '@/components/ProductCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import { seoFor, productCategories, absolute } from '@/lib/content';
import { SITE } from '@/config/site';

export async function getStaticPaths() {
  const products = await getCollection('products');
  const cats = productCategories.filter((c) => c.count > 0);
  return cats.map((category) => ({
    params: { slug: category.slug },
    props: {
      category,
      products: products.filter((p) => p.data.categories.includes(category.slug)),
    },
  }));
}

const { category, products } = Astro.props;
const path = `/product-category/${category.slug}/`;
const seo = seoFor(path);
const name = category.name;

const fallbackCopy: Record<string, string> = {
  'lotion-pump': 'Lotion pumps for body care, hand wash and skincare — 24/410, 28/410 and 28/412 neck sizes, custom colour and closure options.',
  'cream-pump': 'Cream pumps for cosmetic and personal care packaging — precise dosage, non-spill design, full OEM/ODM.',
  'trigger-sprayers': 'Trigger sprayers for household, garden and car care — 28/400 and 28/410, custom colours and output.',
  'fine-mist-sprayer': 'Fine mist sprayers for perfume, toner and facial care — 24/410 and 28/410, gold, silver and UV finishes.',
  'oil-pump': 'Oil pumps engineered for high-viscosity formulas — leak-free dispensing with custom tube lengths.',
  'disc-top-cap': 'Disc top caps and flip-top closures — 24mm and 28mm, smooth or ribbed, custom finishes.',
  'treatment-pump': 'Treatment pumps for serum and skincare — low-dosage accuracy, non-spill, full customisation.',
  'nail-polish-pump': 'Nail polish remover pumps — 24/410, 28/410 and 33/410, leak-proof for solvent-based formulas.',
  'foam-pump': 'Foam pumps for hand wash and facial cleansers — 28/410 and 28/412, consistent foam output.',
};

const intro =
  seo.description ||
  category.description ||
  fallbackCopy[category.slug] ||
  `Browse our ${name} range, manufactured in-house in Cixi, Ningbo, China.`;

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${absolute(path)}#collection`,
    url: absolute(path),
    name: name,
    description: intro,
    isPartOf: { '@id': `${SITE.url}/#website` },
  },
  {
    '@type': 'ItemList',
    itemListElement: products.map((product, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: absolute(`/product/${product.data.slug}/`),
      name: product.data.title,
    })),
  },
];
---

<BaseLayout
  title={seo.title || `${name} Manufacturer | ${SITE.brand} China`}
  description={intro}
  canonicalPath={path}
  schema={schema}
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: name }]} />

  <div class="container-x py-10">
    <h1 class="text-brand">{name} Manufacturer</h1>
    <p class="mt-3 max-w-3xl text-ink/75">{intro}</p>

    <p class="mt-4 text-sm text-muted">
      {products.length} product{products.length === 1 ? '' : 's'} · MOQ from 10,000 pcs · Lead time 15–20 days · OEM/ODM
      available
    </p>

    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {products.map((product, index) => <ProductCard product={product.data} eager={index < 3} />)}
    </div>

    {products.length === 0 && (
      <p class="mt-8 rounded-lg border border-dashed border-line p-6 text-center text-sm text-muted">
        Product sheets for this family are being finalised — <a class="underline" href="/contact-us/"
          >ask us for the current catalogue</a
        >.
      </p>
    )}

    <nav class="mt-12" aria-label="Other product families">
      <h2 class="mb-4 text-lg">Other product families</h2>
      <ul class="flex flex-wrap gap-2">
        {
          productCategories
            .filter((c) => c.count > 0 && c.slug !== category.slug)
            .map((c) => (
              <li>
                <a
                  href={`/product-category/${c.slug}/`}
                  class="rounded-full border border-line bg-white px-4 py-2 text-sm hover:border-accent hover:text-accent-strong"
                >
                  {c.name}
                </a>
              </li>
            ))
        }
      </ul>
    </nav>
  </div>

  <CtaBand source={`category-${category.slug}`} group={name} />
</BaseLayout>
