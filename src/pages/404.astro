---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
---

<BaseLayout
  title={`Page not found | ${SITE.brand}`}
  description="The page you requested could not be found. Browse our cosmetic pump product families or contact us for a quote."
  robots="noindex, follow"
  canonicalPath="/404/"
>
  <section class="container-x flex min-h-[55vh] flex-col items-center justify-center py-16 text-center">
    <p class="text-6xl font-black text-accent">404</p>
    <h1 class="mt-4">Page not found</h1>
    <p class="mt-3 max-w-xl text-ink/75">
      The page you were looking for has moved or no longer exists. Try one of these instead:
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="btn">Home</a>
      <a href="/product-category/lotion-pump/" class="btn btn-ghost">Lotion pumps</a>
      <a href="/product-category/fine-mist-sprayer/" class="btn btn-ghost">Fine mist sprayers</a>
      <a href="/contact-us/" class="btn btn-ghost">Contact us</a>
    </div>
  </section>
</BaseLayout>
