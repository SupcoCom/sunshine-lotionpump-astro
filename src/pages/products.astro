---
/**
 * /products/ — the product archive.
 *
 * Professional B2B catalogue: factory hero, filterable family pills, and a
 * clean spec-driven product grid. Each card surfaces the key B2B specs (size,
 * material, MOQ, lead time) and a direct quote action.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import ProductCard from '@/components/ProductCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import { seoFor, productCategories } from '@/lib/content';
import { SITE } from '@/config/site';

const path = '/products/';
const seo = seoFor(path);

const all = await getCollection('products');
const products = all
  .slice()
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const families = productCategories.filter((c) => c.count > 0);

const schema = [
  {
    '@type': 'CollectionPage',
    '@id': `${SITE.url}${path}#collection`,
    url: `${SITE.url}${path}`,
    name: 'Cosmetic pump products',
    description: seo.description,
    isPartOf: { '@id': `${SITE.url}/#website` },
  },
  {
    '@type': 'ItemList',
    itemListElement: products.map((product, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: new URL(`/product/${product.data.slug}/`, SITE.url).toString(),
      name: product.data.title,
    })),
  },
];
---

<BaseLayout
  title={seo.title || `Cosmetic Pump Products | ${SITE.brand} Manufacturer`}
  description={seo.description ||
    `Browse ${products.length} cosmetic dispensing pumps and closures — lotion pumps, foam pumps, fine mist sprayers, trigger sprayers, disc caps and treatment pumps. Factory direct, custom OEM/ODM.`}
  canonicalPath={path}
  robots="index, follow"
  schema={schema}
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Products' }]} />

  <!-- Catalogue hero — professional B2B -->
  <section class="pp-hero">
    <div class="pp-hero-bg" aria-hidden="true">
      <img
        src="https://img.supcous.com/2026/04/21dec35f4422a9b46ecd7d43d392cb38.webp"
        alt=""
        loading="eager"
        decoding="async"
      />
    </div>
    <div class="container-x pp-hero-inner">
      <div class="pp-hero-head" data-reveal="left">
        <span class="p-eyebrow"><span class="p-eyebrow-dot"></span>Full catalogue</span>
        <h1 class="pp-hero-title">Cosmetic pump products</h1>
        <p class="pp-hero-lede">
          {products.length} standard products across {families.length} families — lotion, cream,
          fine mist, foam, trigger sprayers, treatment, disc top caps, oil and nail polish pumps.
          Every item is manufactured in-house in Yuyao, Ningbo, China.
        </p>
        <dl class="pp-hero-stats">
          <div><dt>Products</dt><dd>{products.length}</dd></div>
          <div><dt>Families</dt><dd>{families.length}</dd></div>
          <div><dt>MOQ from</dt><dd>10,000 pcs</dd></div>
          <div><dt>Lead time</dt><dd>15–20 days</dd></div>
        </dl>
      </div>

      <div class="pp-filter" data-reveal="right">
        <span class="pp-filter-label">Filter by category</span>
        <nav class="pp-filter-pills" aria-label="Product families" data-product-filter>
          <button type="button" class="pp-pill is-active" data-filter="all" aria-pressed="true">All</button>
          {
            families.map((family) => (
              <button type="button" class="pp-pill" data-filter={family.slug} aria-pressed="false">
                {family.name}
              </button>
            ))
          }
        </nav>
      </div>
    </div>
  </section>

  <!-- Product grid -->
  <section class="container-x py-12 md:py-16">
    <div class="pp-grid" data-product-grid>
      {
        products.map((product, index) => (
          <div data-product-category={product.data.categories.join(' ')}>
            <ProductCard product={product.data} eager={index < 3} />
          </div>
        ))
      }
    </div>
  </section>

  <CtaBand source="products-archive" />

  <script>
    const wrapper = document.querySelector<HTMLElement>('[data-product-filter]');
    const grid = document.querySelector<HTMLElement>('[data-product-grid]');
    if (wrapper && grid) {
      const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-product-category]'));
      wrapper.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-filter]');
        if (!button) return;
        const filter = button.dataset.filter ?? 'all';
        wrapper.querySelectorAll('button').forEach((b) => {
          const active = b === button;
          b.setAttribute('aria-pressed', String(active));
          b.classList.toggle('is-active', active);
        });
        cards.forEach((card) => {
          const categories = card.dataset.productCategory ?? '';
          card.hidden = filter !== 'all' && !categories.split(' ').includes(filter);
        });
      });
    }
  </script>
</BaseLayout>