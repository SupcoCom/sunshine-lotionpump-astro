---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CtaBand from '@/components/CtaBand.astro';
import { seoFor, postCategories, formatDate, absolute, type PostCategory } from '@/lib/content';
import { SITE } from '@/config/site';

/**
 * WordPress served post categories nested under a parent:
 *   /category/blog/                (parent)
 *   /category/blog/<slug>/         (children)
 * Both shapes are reproduced exactly, so no redirects are needed.
 */
export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const used = postCategories.filter((c) => c.count > 0);

  return used.map((category) => {
    const isParent = !category.parent;
    // parents live at /category/blog/, children at /category/blog/<slug>/
    const slugParam = isParent ? 'blog' : `blog/${category.slug}`;
    const children = used.filter((c) => c.parent === category.id);
    const matches = (cats: PostCategory[]) =>
      posts.filter((p) =>
        cats.some((c) => p.data.categories.includes(c.slug)),
      );

    return {
      params: { slug: slugParam },
      props: {
        category,
        isParent,
        children,
        posts: matches(isParent ? [category, ...children] : [category]).sort(
          (a, b) => +new Date(b.data.date) - +new Date(a.data.date),
        ),
      },
    };
  });
}

const { category, isParent, children, posts } = Astro.props;
const path = isParent ? '/category/blog/' : `/category/blog/${category.slug}/`;
const seo = seoFor(path);

const name = isParent ? 'Blog' : category.name;
const description =
  seo.description ||
  category.description ||
  `${name} articles from ${SITE.brand} — practical guidance for brands sourcing cosmetic pumps and dispensers from China.`;
---

<BaseLayout
  title={seo.title || `${name} | ${SITE.brand} Blog`}
  description={description}
  canonicalPath={path}
  schema={[
    {
      '@type': 'CollectionPage',
      '@id': `${absolute(path)}#collection`,
      url: absolute(path),
      name,
      description,
      isPartOf: { '@id': `${SITE.url}/#website` },
    },
  ]}
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Blog' }, ...(isParent ? [] : [{ label: name }])]} />

  <div class="container-x py-10">
    <h1 class="text-brand-600">{name}</h1>
    <p class="mt-3 max-w-3xl text-ink/75">{description}</p>

    <nav class="mt-6 flex flex-wrap gap-2" aria-label="Blog categories">
      <a
        href="/category/blog/"
        class:list={[
          'rounded-full border px-4 py-2 text-sm',
          isParent
            ? 'border-accent-500 bg-accent-500 text-white'
            : 'border-line bg-white hover:border-accent-500',
        ]}
      >
        All
      </a>
      {
        children.map((child) => (
          <a
            href={`/category/blog/${child.slug}/`}
            class:list={[
              'rounded-full border px-4 py-2 text-sm',
              child.slug === category.slug
                ? 'border-accent-500 bg-accent-500 text-white'
                : 'border-line bg-white hover:border-accent-500',
            ]}
          >
            {child.name} ({child.count})
          </a>
        ))
      }
    </nav>

    <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post) => (
          <li class="card overflow-hidden">
            <a href={`/${post.data.slug}/`} class="block">
              {post.data.heroImage && (
                <img
                  src={post.data.heroImage}
                  alt=""
                  width="600"
                  height="340"
                  loading="lazy"
                  decoding="async"
                  class="h-44 w-full object-cover"
                />
              )}
              <div class="p-5">
                <p class="text-xs uppercase tracking-wide text-muted">
                  {formatDate(post.data.date)}
                </p>
                <h2 class="mt-2 text-base font-bold leading-snug text-brand-600">
                  {post.data.title}
                </h2>
                <p class="mt-2 line-clamp-3 text-sm text-ink/70">{post.data.excerpt}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    {posts.length === 0 && (
      <p class="mt-8 rounded-lg border border-dashed border-line p-6 text-center text-sm text-muted">
        No articles in this category yet.
      </p>
    )}
  </div>

  <CtaBand source={isParent ? 'blog-index' : `blog-${category.slug}`} />
</BaseLayout>
