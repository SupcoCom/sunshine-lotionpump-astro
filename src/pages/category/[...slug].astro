---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CtaBand from '@/components/CtaBand.astro';
import { seoFor, postCategories, formatDate, absolute, type PostCategory } from '@/lib/content';
import { SITE } from '@/config/site';

/**
 * WordPress served post categories nested under a parent:
 *   /category/blog/                (parent)
 *   /category/blog/<slug>/         (children)
 * Both shapes are reproduced exactly, so no redirects are needed.
 */
export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const used = postCategories.filter((c) => c.count > 0);

  return used.map((category) => {
    const isParent = !category.parent;
    // parents live at /category/blog/, children at /category/blog/<slug>/
    const slugParam = isParent ? 'blog' : `blog/${category.slug}`;
    const children = used.filter((c) => c.parent === category.id);
    const matches = (cats: PostCategory[]) =>
      posts.filter((p) =>
        cats.some((c) => p.data.categories.includes(c.slug)),
      );

    return {
      params: { slug: slugParam },
      props: {
        category,
        isParent,
        children,
        posts: matches(isParent ? [category, ...children] : [category]).sort(
          (a, b) => +new Date(b.data.date) - +new Date(a.data.date),
        ),
      },
    };
  });
}

const { category, isParent, children, posts } = Astro.props;
const path = isParent ? '/category/blog/' : `/category/blog/${category.slug}/`;
const seo = seoFor(path);

const name = isParent ? 'Blog' : category.name;
const description =
  seo.description ||
  category.description ||
  `${name} articles from ${SITE.brand} — practical guidance for brands sourcing cosmetic pumps and dispensers from China.`;
---

<BaseLayout
  title={seo.title || `${name} | ${SITE.brand} Blog`}
  description={description}
  canonicalPath={path}
  schema={[
    {
      '@type': 'CollectionPage',
      '@id': `${absolute(path)}#collection`,
      url: absolute(path),
      name,
      description,
      isPartOf: { '@id': `${SITE.url}/#website` },
    },
  ]}
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Blog' }, ...(isParent ? [] : [{ label: name }])]} />

  <header class="hero-band">
    <div class="container-x hero-band-inner">
      <span class="hero-band-eyebrow">{isParent ? 'Knowledge Hub' : 'Blog category'}</span>
      <h1>{name}</h1>
      <p class="lede">{description}</p>
      <nav class="hero-band-pills" aria-label="Blog categories">
        <a href="/category/blog/" class:list={['hero-pill', isParent && 'is-active']}>All</a>
        {
          children.map((child) => (
            <a
              href={`/category/blog/${child.slug}/`}
              class:list={['hero-pill', child.slug === category.slug && 'is-active']}
            >
              {child.name} ({child.count})
            </a>
          ))
        }
      </nav>
    </div>
  </header>

  <div class="container-x py-12 md:py-16">
    <ul class="grid gap-7 sm:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post) => (
          <li class="blog-card" data-reveal>
            <a href={`/${post.data.slug}/`}>
              {post.data.heroImage && (
                <div class="blog-card-media">
                  <img
                    src={post.data.heroImage}
                    alt=""
                    width="600"
                    height="340"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
              <div class="blog-card-body">
                <span class="blog-card-date">{formatDate(post.data.date)}</span>
                <h2>{post.data.title}</h2>
                <p>{post.data.excerpt}</p>
                <span class="blog-card-more">Read article <span aria-hidden="true">→</span></span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>

    {posts.length === 0 && (
      <p class="rounded-lg border border-dashed border-line p-6 text-center text-sm text-muted">
        No articles in this category yet.
      </p>
    )}
  </div>

  <CtaBand source={isParent ? 'blog-index' : `blog-${category.slug}`} />
</BaseLayout>

<style>
  .blog-card {
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 16px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }
  .blog-card:hover {
    border-color: var(--color-line-strong);
    box-shadow: var(--shadow-card);
    transform: translateY(-5px);
  }
  .blog-card a {
    display: flex;
    height: 100%;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }
  .blog-card-media {
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--color-surface-alt);
    border-bottom: 1px solid var(--color-line);
  }
  .blog-card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .blog-card:hover .blog-card-media img {
    transform: scale(1.04);
  }
  .blog-card-body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 22px;
  }
  .blog-card-date {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .blog-card h2 {
    margin-top: 0.7rem;
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--color-brand);
    transition: color 0.18s ease;
  }
  .blog-card:hover h2 {
    color: var(--color-accent-strong);
  }
  .blog-card p {
    display: -webkit-box;
    overflow: hidden;
    margin-top: 0.7rem;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--color-muted);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }
  .blog-card-more {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    margin-top: auto;
    padding-top: 1.1rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-brand);
  }
  .blog-card-more span {
    transition: transform 0.18s ease;
  }
  .blog-card:hover .blog-card-more {
    color: var(--color-accent);
  }
  .blog-card:hover .blog-card-more span {
    transform: translateX(4px);
  }
</style>
