---
/**
 * /contact-us/ — rebuild of the legacy Elementor page.
 * Address normalised to the footer/home value (see docs/CONTENT-AUDIT.md).
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import LeadForm from '@/components/LeadForm.astro';
import { seoFor } from '@/lib/content';
import { SITE, CONTACT } from '@/config/site';

const path = '/contact-us/';
const seo = seoFor(path);

const channels = [
  {
    title: 'Factory address',
    body: CONTACT.addressOneLine,
    note: 'Near Ningbo Port — efficient global export',
  },
  {
    title: 'Email & WeChat',
    body: `B2B inquiries: ${CONTACT.email}`,
    note: `Phone / WhatsApp: ${CONTACT.phoneDisplay}`,
  },
  {
    title: 'Business hours',
    body: 'Mon – Fri: 08:30 – 18:00 CST',
    note: 'Sat: 09:00 – 13:00 CST · Sun: closed · Email replies within 24 hours',
  },
];

const commitments = [
  'Free samples for qualified B2B buyers',
  'MOQ from 5,000 pcs per SKU',
  'Standard lead time: 15–20 days',
  'Export terms: FOB / CIF / EXW (Ningbo)',
  'OEM/ODM: custom colour, material & print',
];

const quickFacts = [
  ['MOQ: 5,000 pcs', 'Per SKU, standard or custom'],
  ['Lead time: 15–20 days', 'After sample approval'],
  ['Free samples available', 'For qualified B2B buyers'],
  ['FOB / CIF / EXW', 'Ningbo Port, Zhejiang'],
];
---

<BaseLayout
  title={seo.title || `Contact ${SITE.brand} | Cosmetic Pump Manufacturer & Supplier`}
  description={seo.description ||
    `Contact ${SITE.legalName} for factory-direct cosmetic pump pricing, samples and OEM/ODM. Email ${CONTACT.email} — we reply within 24 hours.`}
  canonicalPath={path}
  schema={[
    {
      '@type': 'ContactPage',
      '@id': `${SITE.url}${path}#webpage`,
      url: `${SITE.url}${path}`,
      name: `Contact ${SITE.brand}`,
      isPartOf: { '@id': `${SITE.url}/#website` },
      about: { '@id': `${SITE.url}/#organization` },
    },
  ]}
>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Contact Us' }]} />

  <header class="hero-band">
    <div class="container-x hero-band-inner">
      <span class="hero-band-eyebrow">Contact</span>
      <h1>Get factory-direct pricing</h1>
      <p class="lede">
        Request samples, quotes or OEM/ODM customization for cosmetic pumps and dispensers.
        We reply within 24 hours.
      </p>
      <div class="hero-band-stats">
        <span><strong>24 h</strong> reply time</span>
        <span>Mon–Fri <strong>08:30–18:00</strong> CST</span>
        <span>Export terms <strong>FOB / CIF / EXW</strong></span>
      </div>
    </div>
  </header>

  <section class="container-x py-12 md:py-16">
    <div class="grid gap-5 md:grid-cols-3">
      {
        channels.map((channel, index) => (
          <article class="contact-channel" data-reveal>
            <span class="contact-channel-icon" aria-hidden="true">
              {index === 0 && (
                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657 13.414 20.9a2 2 0 0 1-2.827 0l-4.244-4.243a8 8 0 1 1 11.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 1 1-6 0 3 3 0 0 1 6 0z" />
                </svg>
              )}
              {index === 1 && (
                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 0 0 2.22 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2z" />
                </svg>
              )}
              {index === 2 && (
                <svg width="22" height="22" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="9" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 2" />
                </svg>
              )}
            </span>
            <h2>{channel.title}</h2>
            <p class="contact-channel-body">{channel.body}</p>
            <p class="contact-channel-note">{channel.note}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-[1.15fr_1fr]">
      <div>
        <div class="section-head">
          <span class="eyebrow">Inquiries</span>
          <h2>Send us a message</h2>
          <div class="rule"></div>
        </div>
        <p class="max-w-3xl text-ink/75">
          Tell us about your product requirements — pump type, size, material, quantity and any
          customization needs. Our team will prepare a detailed quote and product recommendation
          within 24 hours.
        </p>

        <ul class="mt-6 space-y-3.5">
          {
            commitments.map((item) => (
              <li class="contact-benefit">
                <span class="contact-benefit-icon" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>

        <div class="contact-direct">
          <h3>Prefer to talk directly?</h3>
          <ul class="mt-3 space-y-2 text-sm">
            <li>
              Email:
              <a href={`mailto:${CONTACT.email}`} class="contact-link">{CONTACT.email}</a>
            </li>
            <li>
              Phone:
              <a href={CONTACT.phoneHref} class="contact-link">{CONTACT.phoneDisplay}</a>
              {' / '}
              <a href="tel:+8615757418802" class="contact-link">{CONTACT.phoneAlt}</a>
            </li>
            <li>
              WhatsApp:
              <a href={CONTACT.whatsappHref} rel="noopener" class="contact-link">{CONTACT.whatsappDisplay}</a>
            </li>
          </ul>
        </div>

        <dl class="mt-8 grid grid-cols-2 gap-4">
          {
            quickFacts.map(([title, note]) => (
              <div class="card p-4">
                <dt class="text-sm font-bold text-brand">{title}</dt>
                <dd class="mt-1 text-xs text-muted">{note}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="contact-form-card">
        <h2 class="font-display text-xl font-bold text-brand">Inquiry form</h2>
        <p class="mt-1 text-sm text-muted">
          Fields marked * are required. We never share your details.
        </p>
        <div class="mt-4">
          <LeadForm
            variant="site"
            source="contact-page"
            submitLabel="Send Inquiry"
            description=""
          />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-channel {
    padding: 26px;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 16px;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }
  .contact-channel:hover {
    border-color: var(--color-line-strong);
    box-shadow: var(--shadow-card);
    transform: translateY(-4px);
  }
  .contact-channel-icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    margin-bottom: 16px;
    border-radius: 12px;
    background: var(--color-accent-soft);
    color: var(--color-accent-strong);
  }
  .contact-channel h2 {
    font-size: 1.05rem;
    font-weight: 700;
  }
  .contact-channel-body {
    margin-top: 0.5rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-ink);
  }
  .contact-channel-note {
    margin-top: 0.4rem;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .contact-benefit {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    font-size: 0.95rem;
  }
  .contact-benefit-icon {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 22px;
    height: 22px;
    margin-top: 0.15rem;
    border-radius: 999px;
    background: var(--color-accent);
    color: #fff;
  }

  .contact-direct {
    margin-top: 2rem;
    padding: 24px;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 16px;
  }
  .contact-direct h3 {
    font-size: 1rem;
    font-weight: 700;
  }
  .contact-link {
    font-weight: 600;
    color: var(--color-accent-strong);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .contact-link:hover {
    color: var(--color-accent);
  }

  .contact-form-card {
    position: sticky;
    top: 96px;
    align-self: start;
    padding: clamp(22px, 3vw, 32px);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-top: 4px solid var(--color-accent);
    border-radius: 16px;
    box-shadow: var(--shadow-pop);
  }
</style>
