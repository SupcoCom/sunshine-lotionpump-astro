---
/**
 * Single dispatcher for every root-level URL that came from WordPress.
 *
 * WordPress permalinks are flat (`/about-us/`, `/lotion-pump-quality-testing/`,
 * `/foam-pump-manufacturer-landingpage/`), so instead of inventing a new URL
 * scheme this route reproduces the legacy paths 1:1 from `src/data/registry.json`.
 * That is what keeps the migration SEO-neutral.
 *
 * Three shapes are handled:
 *   landing → ported landing-page HTML, rendered with the LP layout + unified lead form
 *   post    → blog article (markdown body containing the original HTML)
 *   page    → simple content page / long-form SEO article
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import LpLayout from '@/layouts/LpLayout.astro';
import LeadForm from '@/components/LeadForm.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CtaBand from '@/components/CtaBand.astro';
import {
  registry,
  readPortableHtml,
  splitLeadMarkers,
  seoFor,
  formatDate,
  absolute,
  stripBrand,
  type RouteEntry,
} from '@/lib/content';
import { SITE, CONTACT } from '@/config/site';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const bySlug = new Map(posts.map((post) => [post.data.slug, post]));

  return registry.map((entry) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      post: entry.type === 'post' ? bySlug.get(entry.slug) : undefined,
    },
  }));
}

type PostEntry = Awaited<ReturnType<typeof getCollection<'posts'>>>[number];

interface Props {
  entry: RouteEntry;
  post?: PostEntry;
}
const { entry, post } = Astro.props;

const seo = seoFor(entry.path);
// Keep the exact string WordPress/Rank Math emitted (word order included) so the
// rebuild is identical to what search engines were reading. Pages without a
// snapshot fall back to the default in BaseLayout.
const robots = seo.robots && seo.robots.trim() ? seo.robots : undefined;

const pageTitle = seo.title || `${stripBrand(entry.title)} | ${SITE.brand}`;
const description =
  seo.description ||
  post?.data.excerpt ||
  `${stripBrand(entry.title)} — ${SITE.shortDescription}`;

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  ...(entry.type === 'post' ? [{ label: 'Blog', href: '/category/blog/' }] : []),
  { label: stripBrand(entry.title) },
];

const origin = SITE.url;
---

{
  entry.type === 'landing' ? (
    <LpLayout
      title={pageTitle}
      description={description}
      canonicalPath={entry.path}
      robots={robots}
      schema={[
        {
          '@type': 'WebPage',
          '@id': `${absolute(entry.path)}#webpage`,
          url: absolute(entry.path),
          name: pageTitle,
          description,
          isPartOf: { '@id': `${origin}/#website` },
        },
        {
          '@type': 'Organization',
          '@id': `${origin}/#organization`,
          name: SITE.legalName,
          url: origin,
          email: CONTACT.email,
          telephone: CONTACT.phoneDisplay,
        },
      ]}
    >
      {splitLeadMarkers(readPortableHtml('landing', entry.slug)).map((chunk) =>
        chunk.kind === 'lead' ? (
          <LeadForm variant="lp" source={chunk.source} submitLabel="Send My Requirement" />
        ) : (
          <Fragment set:html={chunk.html} />
        ),
      )}
    </LpLayout>
  ) : entry.type === 'post' && post ? (
    <BaseLayout
      title={pageTitle}
      description={description}
      canonicalPath={entry.path}
      ogType="article"
      publishedTime={post.data.date}
      schema={[
        {
          '@type': 'BlogPosting',
          '@id': `${absolute(entry.path)}#article`,
          headline: post.data.title,
          description,
          datePublished: post.data.date,
          dateModified: post.data.modified || post.data.date,
          mainEntityOfPage: absolute(entry.path),
          author: { '@id': `${origin}/#organization` },
          publisher: { '@id': `${origin}/#organization` },
          articleSection: post.data.categoryNames?.[0],
        },
      ]}
    >
      <Breadcrumbs items={breadcrumbItems} />
      <article class="container-x py-10">
        <header class="mx-auto max-w-3xl">
          <h1 class="text-brand">{stripBrand(post.data.title)}</h1>
          <p class="mt-3 text-sm text-muted">
            Updated {formatDate(post.data.modified || post.data.date)}
            {post.data.categoryNames?.length > 0 && (
              <>
                {' · '}
                {post.data.categories.map((slug, index) => (
                  <a
                    href={`/category/blog/${slug}/`}
                    class="mr-2 rounded bg-surface px-2 py-0.5 text-xs hover:bg-brand-soft hover:text-brand"
                  >
                    {post.data.categoryNames[index]}
                  </a>
                ))}
              </>
            )}
          </p>
        </header>
        <div class="prose-wp mx-auto mt-8 max-w-3xl" set:html={post.body ?? ''} />
      </article>
      <CtaBand source="article-cta" />
    </BaseLayout>
  ) : (
    <BaseLayout
      title={pageTitle}
      description={description}
      canonicalPath={entry.path}
      robots={robots}
      schema={[
        {
          '@type': 'WebPage',
          '@id': `${absolute(entry.path)}#webpage`,
          url: absolute(entry.path),
          name: pageTitle,
          description,
          isPartOf: { '@id': `${origin}/#website` },
        },
      ]}
    >
      <Breadcrumbs items={breadcrumbItems} />
      <div
        class:list={[
          'container-x py-10',
          entry.slug === 'thank-you' ? 'max-w-2xl text-center' : '',
        ]}
      >
        {
          entry.slug !== 'thank-you' && entry.slug !== 'privacy-policy' && (
            <h1 class="mb-6">{stripBrand(entry.title)}</h1>
          )
        }
        <div
          class="prose-wp mx-auto max-w-3xl"
          set:html={readPortableHtml('pages', entry.slug)}
        />
      </div>
      {entry.slug !== 'thank-you' && <CtaBand source={`page-${entry.slug}`} />}
    </BaseLayout>
  )
}
