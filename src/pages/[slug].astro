---
/**
 * Single dispatcher for every root-level URL that came from WordPress.
 *
 * WordPress permalinks are flat (`/about-us/`, `/lotion-pump-quality-testing/`,
 * `/foam-pump-manufacturer-landingpage/`), so instead of inventing a new URL
 * scheme this route reproduces the legacy paths 1:1 from `src/data/registry.json`.
 * That is what keeps the migration SEO-neutral.
 *
 * Three shapes are handled:
 *   landing → ported landing-page HTML, rendered with the LP layout + unified lead form
 *   post    → blog article (markdown body containing the original HTML)
 *   page    → simple content page / long-form SEO article
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import LpLayout from '@/layouts/LpLayout.astro';
import LeadForm from '@/components/LeadForm.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import CtaBand from '@/components/CtaBand.astro';
import {
  registry,
  readPortableHtml,
  splitLeadMarkers,
  seoFor,
  formatDate,
  absolute,
  stripBrand,
  type RouteEntry,
} from '@/lib/content';
import { SITE, CONTACT } from '@/config/site';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  const bySlug = new Map(posts.map((post) => [post.data.slug, post]));

  return registry.map((entry) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      post: entry.type === 'post' ? bySlug.get(entry.slug) : undefined,
    },
  }));
}

type PostEntry = Awaited<ReturnType<typeof getCollection<'posts'>>>[number];

interface Props {
  entry: RouteEntry;
  post?: PostEntry;
}
const { entry, post } = Astro.props;

const seo = seoFor(entry.path);
// Keep the exact string WordPress/Rank Math emitted (word order included) so the
// rebuild is identical to what search engines were reading. Pages without a
// snapshot fall back to the default in BaseLayout.
const robots = seo.robots && seo.robots.trim() ? seo.robots : undefined;

const pageTitle = seo.title || `${stripBrand(entry.title)} | ${SITE.brand}`;
const description =
  seo.description ||
  post?.data.excerpt ||
  `${stripBrand(entry.title)} — ${SITE.shortDescription}`;

const breadcrumbItems = [
  { label: 'Home', href: '/' },
  ...(entry.type === 'post' ? [{ label: 'Blog', href: '/category/blog/' }] : []),
  { label: stripBrand(entry.title) },
];

const origin = SITE.url;

let articleHtml = post?.body ?? '';
const toc: { id: string; text: string }[] = [];
if (post) {
  let i = 0;
  articleHtml = articleHtml.replace(
    /<h2([^>]*)>([\s\S]*?)<\/h2>/g,
    (_m, attrs: string, inner: string) => {
      const text = inner.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
      const existing = attrs.match(/id="([^"]+)"/);
      const slug =
        text
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '')
          .slice(0, 60) || `section-${i}`;
      const id = existing?.[1] ?? slug;
      toc.push({ id, text });
      const cleaned = attrs.replace(/\s*id="[^"]*"/, '').trim();
      i += 1;
      return `<h2 id="${id}" ${cleaned}>${inner}</h2>`;
    },
  );
}
const wordCount = articleHtml.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const readMin = Math.max(1, Math.round(wordCount / 200));
articleHtml = articleHtml
  .replace(/<table\b/gi, '<div class="table-scroll"><table')
  .replace(/<\/table>/gi, '</table></div>');
---

{
  entry.type === 'landing' ? (
    <LpLayout
      title={pageTitle}
      description={description}
      canonicalPath={entry.path}
      robots={robots}
      schema={[
        {
          '@type': 'WebPage',
          '@id': `${absolute(entry.path)}#webpage`,
          url: absolute(entry.path),
          name: pageTitle,
          description,
          isPartOf: { '@id': `${origin}/#website` },
        },
        {
          '@type': 'Organization',
          '@id': `${origin}/#organization`,
          name: SITE.legalName,
          url: origin,
          email: CONTACT.email,
          telephone: CONTACT.phoneDisplay,
        },
      ]}
    >
      {splitLeadMarkers(readPortableHtml('landing', entry.slug)).map((chunk) =>
        chunk.kind === 'lead' ? (
          <LeadForm variant="lp" source={chunk.source} submitLabel="Send My Requirement" />
        ) : (
          <Fragment set:html={chunk.html} />
        ),
      )}
    </LpLayout>
  ) : entry.type === 'post' && post ? (
    <BaseLayout
      title={pageTitle}
      description={description}
      canonicalPath={entry.path}
      ogType="article"
      publishedTime={post.data.date}
      schema={[
        {
          '@type': 'BlogPosting',
          '@id': `${absolute(entry.path)}#article`,
          headline: post.data.title,
          description,
          datePublished: post.data.date,
          dateModified: post.data.modified || post.data.date,
          mainEntityOfPage: absolute(entry.path),
          author: { '@id': `${origin}/#organization` },
          publisher: { '@id': `${origin}/#organization` },
          articleSection: post.data.categoryNames?.[0],
        },
      ]}
    >
      <div id="reading-progress" class="post-progress" aria-hidden="true"></div>
      <Breadcrumbs items={breadcrumbItems} />

      <header class="post-hero">
        <div class="container-x post-hero-inner">
          <span class="post-eyebrow">
            {post.data.categoryNames?.[0] ?? 'Blog'} · {formatDate(post.data.date)}
          </span>
          <h1 class="post-title">{stripBrand(post.data.title)}</h1>
          {post.data.excerpt && <p class="post-lede">{post.data.excerpt}</p>}
          <div class="post-meta">
            {post.data.categoryNames?.length > 0 &&
              post.data.categories.map((slug, index) => (
                <a
                  href={slug === 'blog' ? '/category/blog/' : `/category/blog/${slug}/`}
                  class="post-pill"
                >
                  {post.data.categoryNames[index]}
                </a>
              ))}
            <span class="post-meta-text">Updated {formatDate(post.data.modified || post.data.date)}</span>
            <span class="post-meta-dot" aria-hidden="true">·</span>
            <span class="post-meta-text">{readMin} min read</span>
          </div>
        </div>
      </header>

      <div class="container-x post-layout grid gap-12 py-12 lg:grid-cols-[minmax(0,1fr)_230px]">
        <div class="post-card prose-wp" set:html={articleHtml} data-article-body />
        {toc.length > 1 && (
          <aside class="post-toc" data-toc>
            <span class="post-toc-title">On this page</span>
            <nav>
              {toc.map((item) => (
                <a href={`#${item.id}`}>{item.text}</a>
              ))}
            </nav>
          </aside>
        )}
      </div>

      <CtaBand source="article-cta" />

      <script>
        const bar = document.getElementById('reading-progress');
        const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc] nav a'));
        const heads = tocLinks
          .map((a) => document.querySelector<HTMLElement>(a.getAttribute('href') ?? ''))
          .filter((el): el is HTMLElement => Boolean(el));

        const onScroll = () => {
          if (bar) {
            const doc = document.documentElement;
            const max = doc.scrollHeight - window.innerHeight;
            bar.style.width = `${max > 0 ? (doc.scrollTop / max) * 100 : 0}%`;
          }
          if (heads.length) {
            let current = heads[0];
            for (const head of heads) {
              if (head.getBoundingClientRect().top <= 140) current = head;
            }
            tocLinks.forEach((a) =>
              a.classList.toggle('is-active', a.getAttribute('href') === `#${current.id}`),
            );
          }
        };
        document.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      </script>
    </BaseLayout>
  ) : (
    <BaseLayout
      title={pageTitle}
      description={description}
      canonicalPath={entry.path}
      robots={robots}
      schema={[
        {
          '@type': 'WebPage',
          '@id': `${absolute(entry.path)}#webpage`,
          url: absolute(entry.path),
          name: pageTitle,
          description,
          isPartOf: { '@id': `${origin}/#website` },
        },
      ]}
    >
      <Breadcrumbs items={breadcrumbItems} />
      <div
        class:list={[
          'container-x py-10',
          entry.slug === 'thank-you' ? 'max-w-2xl text-center' : '',
        ]}
      >
        {
          entry.slug !== 'thank-you' && entry.slug !== 'privacy-policy' && (
            <h1 class="mb-6">{stripBrand(entry.title)}</h1>
          )
        }
        <div
          class="prose-wp mx-auto max-w-3xl"
          set:html={readPortableHtml('pages', entry.slug)
            .replace(/<table\b/gi, '<div class="table-scroll"><table')
            .replace(/<\/table>/gi, '</table></div>')}
        />
      </div>
      {entry.slug !== 'thank-you' && <CtaBand source={`page-${entry.slug}`} />}
    </BaseLayout>
  )
}

<style>
  .post-progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 80;
    width: 0;
    height: 3px;
    background: var(--color-accent);
    transition: width 0.1s linear;
  }

  .post-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-brand-strong);
    color: #fff;
  }
  .post-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(120% 90% at 50% 0%, #000 30%, transparent 100%);
  }
  .post-hero::after {
    content: '';
    position: absolute;
    bottom: -40%;
    left: -10%;
    width: 50vw;
    height: 50vw;
    max-width: 560px;
    max-height: 560px;
    background: radial-gradient(circle, rgba(228, 87, 15, 0.28), transparent 65%);
    pointer-events: none;
  }
  .post-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 880px;
    margin-inline: auto;
    padding-block: clamp(52px, 8vw, 96px);
    text-align: center;
  }
  .post-eyebrow {
    display: block;
    margin-bottom: 1.25rem;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent-bright);
  }
  .post-title {
    color: #fff;
    font-size: clamp(2rem, 1.15rem + 3.2vw, 3.6rem);
  }
  .post-lede {
    max-width: 62ch;
    margin: 1.4rem auto 0;
    font-size: clamp(1rem, 0.95rem + 0.4vw, 1.15rem);
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.78);
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    justify-content: center;
    margin-top: 2rem;
  }
  .post-pill {
    display: inline-flex;
    padding: 0.4rem 0.9rem;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    font-size: 0.78rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    transition: background-color 0.18s ease, border-color 0.18s ease;
  }
  .post-pill:hover {
    background: rgba(240, 160, 75, 0.18);
    border-color: var(--color-accent-bright);
  }
  .post-meta-text {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.6);
  }
  .post-meta-dot {
    color: rgba(255, 255, 255, 0.4);
  }

  .post-layout {
    align-items: start;
  }
  .post-card {
    min-width: 0;
    padding: clamp(24px, 4vw, 56px);
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 20px;
    box-shadow: var(--shadow-card);
    font-size: 1.0625rem;
    line-height: 1.8;
  }
  .post-card :global(p:first-of-type) {
    font-size: 1.15rem;
    color: var(--color-muted);
  }
  .post-card :global(p:first-of-type::first-letter) {
    float: left;
    margin: 0.06em 0.12em 0 0;
    font-family: var(--font-display);
    font-size: 3.4em;
    font-weight: 800;
    line-height: 0.82;
    color: var(--color-accent);
  }
  .post-card :global(h2) {
    margin-top: 2.8rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--color-line);
    scroll-margin-top: 96px;
  }
  .post-card :global(h3) {
    scroll-margin-top: 96px;
  }
  .post-card :global(img) {
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card);
  }
  .post-card :global(blockquote) {
    margin-inline: -0.5rem;
    padding: 0.75rem 1.25rem;
    border-radius: 0 12px 12px 0;
    background: var(--color-surface-alt);
    font-style: normal;
  }

  .post-toc {
    display: none;
  }
  @media (min-width: 1024px) {
    .post-toc {
      display: block;
      position: sticky;
      top: 96px;
      align-self: start;
    }
  }
  .post-toc-title {
    display: block;
    margin-bottom: 0.9rem;
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-faint);
  }
  .post-toc a {
    display: block;
    padding: 0.4rem 0 0.4rem 0.85rem;
    border-left: 2px solid var(--color-line);
    font-size: 0.85rem;
    line-height: 1.45;
    color: var(--color-muted);
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease;
  }
  .post-toc a:hover {
    color: var(--color-brand);
  }
  .post-toc a.is-active {
    border-left-color: var(--color-accent);
    font-weight: 600;
    color: var(--color-brand);
  }
</style>
