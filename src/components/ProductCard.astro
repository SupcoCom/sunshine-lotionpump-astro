---
interface Props {
  product: {
    slug: string;
    title: string;
    image?: string;
    imageAlt?: string;
    size?: string[];
    material?: string;
    moq?: string;
    leadTime?: string;
    supplyAbility?: string;
    sample?: string;
    oemOdm?: string;
    origin?: string;
    characteristic?: string;
    types?: string;
  };
  eager?: boolean;
}

const { product, eager = false } = Astro.props;
const specs = [
  { label: 'Size', value: product.size?.join(', ') },
  { label: 'Material', value: product.material },
  { label: 'MOQ', value: product.moq },
  { label: 'Lead time', value: product.leadTime },
  { label: 'Capacity', value: product.supplyAbility },
  { label: 'Sample', value: product.sample },
  { label: 'OEM/ODM', value: product.oemOdm },
  { label: 'Origin', value: product.origin },
].filter((s) => s.value);
const firstSpecs = specs.slice(0, 4);
---

<article class="pp-card" data-reveal>
  <a href={`/product/${product.slug}/`} class="pp-card-img">
    {
      product.image ? (
        <img
          src={product.image}
          alt={product.imageAlt || product.title}
          width="400"
          height="400"
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : (
        <div class="grid aspect-square w-full place-items-center text-xs text-faint">Image on request</div>
      )
    }
    {product.types && <span class="pp-card-type">{product.types}</span>}
  </a>
  <div class="pp-card-body">
    <h3 class="pp-card-title">
      <a href={`/product/${product.slug}/`}>{product.title}</a>
    </h3>
    {product.characteristic && <p class="pp-card-char">{product.characteristic}</p>}
    <dl class="pp-card-specs">
      {firstSpecs.map((spec) => (
        <div class="pp-card-spec">
          <dt>{spec.label}</dt>
          <dd>{spec.value}</dd>
        </div>
      ))}
    </dl>
    <div class="pp-card-foot">
      <button
        type="button"
        class="btn btn-sm"
        data-open-quote
        data-quote-product={product.title}
      >
        Get a Quote
      </button>
      <a href={`/product/${product.slug}/`} class="pp-card-view">Details</a>
    </div>
  </div>
</article>