---
interface Row {
  label: string;
  value: string;
}
interface Props {
  rows: Row[];
  caption?: string;
}
const { rows, caption } = Astro.props;
---

<div class="card overflow-hidden" data-reveal>
  {caption && (
    <div class="border-b border-line bg-surface-alt px-5 py-3.5">
      <span class="text-[11px] font-bold uppercase tracking-[0.14em] text-brand">{caption}</span>
    </div>
  )}
  <dl class="grid sm:grid-cols-2">
    {
      rows.map((row, index) => (
        <div
          class:list={[
            'flex flex-col gap-1 border-line px-5 py-4',
            index % 2 === 0 ? 'bg-white' : 'bg-surface-alt/40',
            'border-b sm:border-r',
            index % 2 === 1 ? 'sm:border-r-0' : '',
          ]}
        >
          <dt class="text-[11px] font-bold uppercase tracking-[0.12em] text-faint">{row.label}</dt>
          <dd class="text-[15px] font-semibold text-ink">{row.value}</dd>
        </div>
      ))
    }
  </dl>
</div>
