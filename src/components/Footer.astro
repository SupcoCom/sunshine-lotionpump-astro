---
import { NAV, CONTACT, SITE, PRODUCT_CATEGORIES } from '@/config/site';

const year = new Date().getFullYear();
const productLinks = PRODUCT_CATEGORIES.map((c) => ({
  label: c.label,
  href: `/product-category/${c.slug}/`,
}));
---

<footer class="mt-20 bg-brand-700 text-white/85">
  <div class="container-x grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">
    <div>
      <div class="mb-4 flex items-center gap-2.5">
        <span class="grid size-9 place-items-center rounded-md bg-white text-lg font-black text-brand-600"
          >S</span
        >
        <strong class="text-base font-black text-white">{SITE.brand} Plastic</strong>
      </div>
      <p class="text-sm leading-relaxed text-white/75">
        {SITE.legalName}. {SITE.shortDescription} Serving buyers globally since {SITE.established}.
        ISO 9001:2015 certified. Factory: 7,000 m², Cixi, Ningbo, China.
      </p>
      <a
        href={CONTACT.alibaba}
        rel="noopener nofollow"
        target="_blank"
        class="mt-4 inline-block text-sm font-semibold text-accent-400 hover:text-white"
        >View our Alibaba store →</a
      >
    </div>

    <nav aria-label="Footer products">
      <h2 class="mb-4 text-sm font-bold uppercase tracking-[0.14em] text-white">Products</h2>
      <ul class="space-y-2 text-sm">
        <li>
          <a href="/products/" class="text-white/75 hover:text-accent-400">All products</a>
        </li>
        {
          productLinks.map((link) => (
            <li>
              <a href={link.href} class="text-white/75 hover:text-accent-400">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-label="Footer navigation">
      <h2 class="mb-4 text-sm font-bold uppercase tracking-[0.14em] text-white">Quick Links</h2>
      <ul class="space-y-2 text-sm">
        {
          NAV.map((item) => (
            <li>
              {item.href ? (
                <a href={item.href} class="text-white/75 hover:text-accent-400">
                  {item.label}
                </a>
              ) : (
                <details>
                  <summary class="cursor-pointer text-white/75 hover:text-accent-400">
                    {item.label}
                  </summary>
                  <ul class="mt-2 space-y-1.5 pl-3">
                    {item.children?.map((child) => (
                      <li>
                        <a href={child.href} class="text-white/60 hover:text-accent-400">
                          {child.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div>
      <h2 class="mb-4 text-sm font-bold uppercase tracking-[0.14em] text-white">Get In Touch</h2>
      <ul class="space-y-3 text-sm text-white/75">
        <li>{CONTACT.addressOneLine}</li>
        <li>
          Email:
          <a href={`mailto:${CONTACT.email}`} class="hover:text-accent-400">{CONTACT.email}</a>
        </li>
        <li>
          Phone:
          <a href={CONTACT.phoneHref} class="hover:text-accent-400">{CONTACT.phoneDisplay}</a>
          {' / '}
          <a href="tel:+8615757418802" class="hover:text-accent-400">{CONTACT.phoneAlt}</a>
        </li>
        <li>WhatsApp: <a href={CONTACT.whatsappHref} rel="noopener" class="hover:text-accent-400">{CONTACT.whatsappDisplay}</a></li>
        <li>Hours: {CONTACT.hours}</li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/15">
    <div
      class="container-x flex flex-col gap-2 py-5 text-xs text-white/60 md:flex-row md:items-center md:justify-between"
    >
      <p>
        Copyright © {year} {SITE.legalName}. All Rights Reserved. Wholesale Plastic Dispenser
        Pump Manufacturers.
      </p>
      <p>
        <a href="/privacy-policy/" class="hover:text-accent-400">Privacy Policy</a>
        <span class="mx-2" aria-hidden="true">·</span>
        Built headless on Astro
      </p>
    </div>
  </div>
</footer>
