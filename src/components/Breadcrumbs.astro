---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;

const schema = {
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, Astro.site ?? Astro.url).toString() } : {}),
  })),
};
---

<nav aria-label="Breadcrumb" class="border-b border-line bg-surface">
  <div class="container-x py-3">
    <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted">
      {
        items.map((item, index) => (
          <li class="flex items-center gap-2">
            {item.href && index < items.length - 1 ? (
              <a href={item.href} class="hover:text-brand-600">{item.label}</a>
            ) : (
              <span class="font-medium text-brand-600">{item.label}</span>
            )}
            {index < items.length - 1 && <span aria-hidden="true">/</span>}
          </li>
        ))
      }
    </ol>
  </div>
</nav>
<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
