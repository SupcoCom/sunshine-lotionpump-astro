---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;

const schema = {
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, Astro.site ?? Astro.url).toString() } : {}),
  })),
};
---

<nav aria-label="Breadcrumb" class="border-b border-line bg-surface-alt/60">
  <div class="container-x py-3.5">
    <ol class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-faint">
      {
        items.map((item, index) => (
          <li class="flex items-center gap-2">
            {item.href && index < items.length - 1 ? (
              <a href={item.href} class="transition hover:text-brand">{item.label}</a>
            ) : (
              <span class="font-semibold text-brand">{item.label}</span>
            )}
            {index < items.length - 1 && (
              <svg width="10" height="10" viewBox="0 0 24 24" aria-hidden="true" class="text-line-strong"><path d="M9 6l6 6-6 6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></svg>
            )}
          </li>
        ))
      }
    </ol>
  </div>
</nav>
<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
