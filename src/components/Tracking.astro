---
/**
 * Analytics — direct gtag.js, identical to the live WordPress site.
 *
 * The legacy site loads gtag.js with the Google Ads id and configures both
 * GA4 and Google Ads. The lead form fires the verified conversion label on
 * success. No GTM container is involved.
 */
import { TRACKING } from '@/config/site';

const { ga4Id, googleAdsId, conversionLabel } = TRACKING;
---

<script is:inline define:vars={{ ga4Id, googleAdsId, conversionLabel }}>
  // Stub gtag immediately so lead form calls never throw before the real script loads.
  window.dataLayer = window.dataLayer || [];
  function gtag() { window.dataLayer.push(arguments); }
  window.gtag = window.gtag || gtag;

  const idle =
    (typeof requestIdleCallback === 'function' && requestIdleCallback) ||
    ((cb) => setTimeout(cb, 0));

  // Load gtag.js itself only after the browser is idle, so analytics never
  // sits on the critical path / blocks first paint. The stub above captures
  // any early lead-form events and replays them once gtag.js is ready.
  idle(() => {
    try {
      const s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + googleAdsId;
      s.onload = function () {
        gtag('js', new Date());
        gtag('config', googleAdsId);
        gtag('config', ga4Id);
      };
      document.head.appendChild(s);
    } catch (e) {
      // analytics must never break the page
    }
  });

  // Lead conversion helper — called by the lead form on success.
  window.sunshineTrackLead = function (source) {
    window.dataLayer.push({
      event: 'generate_lead',
      lead_source: source || 'unknown',
      form_location: document.location.pathname,
    });
    try {
      gtag('event', 'conversion', { send_to: conversionLabel });
    } catch (e) {
      // ignore
    }
  };
</script>
