---
import LeadForm from '@/components/LeadForm.astro';
import { CONTACT } from '@/config/site';

interface Props {
  source?: string;
  group?: string;
  eyebrow?: string;
  title?: string;
  description?: string;
}

const {
  source = 'site-cta',
  group = '',
  eyebrow = 'Reply within 24 hours',
  title = 'Request Your Factory-Direct Quote',
  description = "Share your requirements — pump type, size, volume and quantity. We'll respond within 24 hours with factory pricing and a sample recommendation.",
} = Astro.props;

const promises = [
  'Quality issues? We remake for free',
  'Late delivery? 5% discount on next order',
  'Not satisfied? We resolve it — no excuses',
  'Customer satisfaction is our priority',
];
---

<section id="quote" class="border-y border-line bg-surface-alt py-20">
  <div class="container-x grid gap-12 lg:grid-cols-2">
    <div data-reveal>
      <span class="eyebrow">{eyebrow}</span>
      <h2>{title}</h2>
      <p class="mt-4 max-w-xl leading-relaxed text-muted">{description}</p>

      <ul class="mt-7 space-y-2.5 text-sm text-ink/80">
        {promises.map((promise) => (
          <li class="flex gap-2.5">
            <span class="mt-0.5 grid size-4 shrink-0 place-items-center rounded-full bg-brand-soft text-[10px] font-bold text-brand">✓</span>
            <span>{promise}</span>
          </li>
        ))}
      </ul>

      <div class="mt-9 space-y-3 border-t border-line pt-7 text-sm">
        <p><a href={`mailto:${CONTACT.email}`} class="font-medium text-brand hover:text-accent">✉ {CONTACT.email}</a></p>
        <p><a href={CONTACT.phoneHref} class="font-medium text-brand hover:text-accent">☎ Call us: {CONTACT.phoneDisplay}</a></p>
        <p><a href={CONTACT.whatsappHref} rel="noopener" class="font-medium text-brand hover:text-accent">WhatsApp: {CONTACT.whatsappDisplay}</a></p>
      </div>
    </div>

    <div class="card h-fit p-7" data-reveal>
      <LeadForm variant="site" source={source} group={group} submitLabel="Get Your Factory-Direct Quote" />
    </div>
  </div>
</section>
